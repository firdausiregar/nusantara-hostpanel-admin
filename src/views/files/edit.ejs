<%- include('../partials/app-start') %>
<section class="card p-5 sm:p-6"><div class="flex items-end justify-between gap-4"><div><div class="metric-kicker">Text editor</div><h2 class="mt-1 text-xl font-bold"><%= file.path %></h2><p class="mt-1 text-xs text-slate-600">Max 1 MB · binary files ditolak</p></div><a class="btn-secondary" href="/files/app/<%= app.id %>?path=<%= encodeURIComponent(file.path.split('/').slice(0,-1).join('/')) %>">Back</a></div><form class="mt-5" method="post" action="/files/app/<%= app.id %>/save"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="path" value="<%= file.path %>"><input type="hidden" name="parent" value="<%= file.path.split('/').slice(0,-1).join('/') %>"><textarea class="field min-h-[65vh] font-mono text-xs" name="content" spellcheck="false"><%= file.content %></textarea><button class="btn-primary mt-4" type="submit">Save file</button></form></section>
<%- include('../partials/app-end') %>
