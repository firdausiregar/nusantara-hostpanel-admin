<%- include('../partials/app-start') %>
<div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><div class="metric-kicker">Project storage</div><h2 class="mt-1 text-2xl font-black"><%= app.name %> · Files</h2><p class="mt-2 font-mono text-xs text-slate-600">/<%= data.path||'' %></p></div><div class="flex gap-2"><a class="btn-secondary" href="/apps/<%= app.id %>">Project</a><a class="btn-secondary" href="/files/app/<%= app.id %>">Root</a></div></div>
<% if(error){ %><div class="card mt-5 border-red-400/20 p-4 text-sm text-red-200"><%= error %></div><% } %>
<section class="card mt-6 overflow-hidden"><div class="table-wrap border-0"><table class="table"><thead><tr><th>Name</th><th>Type</th><th>Size</th><th>Modified</th><th></th></tr></thead><tbody><% if(data.path){const parent=data.path.split('/').slice(0,-1).join('/'); %><tr><td><a class="font-semibold text-gold-300" href="/files/app/<%= app.id %>?path=<%= encodeURIComponent(parent) %>">..</a></td><td>dir</td><td>-</td><td>-</td><td></td></tr><% } %><% data.items.forEach(i=>{const p=[data.path,i.name].filter(Boolean).join('/');%><tr><td class="font-mono text-xs"><% if(i.type==='dir'){ %><a class="font-semibold text-gold-300" href="/files/app/<%= app.id %>?path=<%= encodeURIComponent(p) %>"><%= i.name %>/</a><% }else{ %><%= i.name %><% } %></td><td><span class="badge"><%= i.type %></span></td><td><%= i.type==='file'?formatBytes(i.sizeBytes):'-' %></td><td class="text-xs text-slate-600"><%= i.mtime %></td><td class="text-right"><% if(i.type==='file'){ %><a class="btn-secondary" href="/files/app/<%= app.id %>/edit?path=<%= encodeURIComponent(p) %>">Edit</a><% } %><form class="inline" method="post" action="/files/app/<%= app.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="path" value="<%= p %>"><input type="hidden" name="parent" value="<%= data.path %>"><button class="btn-danger" data-confirm="Hapus <%= p %>?" type="submit">Delete</button></form></td></tr><% }) %></tbody></table></div></section>
<section class="card mt-6 p-5"><div class="metric-kicker">Upload</div><h3 class="mt-1 font-bold">Upload file ≤ 2 MB</h3><p class="mt-2 text-xs text-slate-600">.git, node_modules, .env dan file internal panel diblok. Untuk secret gunakan Environment Manager.</p><form data-file-upload data-action="/files/app/<%= app.id %>/upload" data-csrf="<%= csrfToken %>" class="mt-4 flex flex-col gap-3 sm:flex-row"><input type="hidden" name="dir" value="<%= data.path %>"><input class="field" type="file" name="file" required><button class="btn-primary" type="submit">Upload</button></form><p data-upload-status class="mt-2 text-xs text-slate-500"></p></section>
<%- include('../partials/app-end') %>
