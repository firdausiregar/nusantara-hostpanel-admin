<%- include('../partials/app-start') %><div class="flex justify-between gap-4"><div><div class="metric-kicker">Automation</div><h2 class="mt-1 text-2xl font-black"><%= app.name %> · Scheduled Jobs</h2><p class="mt-2 text-sm text-slate-500">Menggunakan systemd timers, bukan cron shell bebas. Command tetap melewati allowlist parser.</p></div><a class="btn-secondary h-fit" href="/apps/<%= app.id %>">← Project</a></div><div class="mt-6 grid gap-6 xl:grid-cols-[1fr_.8fr]"><section class="table-wrap"><table class="table"><thead><tr><th>Job</th><th>Schedule</th><th>Next run</th><th></th></tr></thead><tbody><% if(!jobs.length){ %><tr><td colspan="4" class="text-slate-500">Belum ada job.</td></tr><% } %><% jobs.forEach(j=>{ %><tr><td><strong><%= j.name %></strong><div class="mt-1 font-mono text-xs text-slate-600"><%= j.command %></div></td><td><code><%= j.schedule %></code></td><td class="text-xs text-slate-500"><%= j.runtime?.nextRun||'-' %></td><td class="text-right"><form method="post" action="/cron/app/<%= app.id %>/<%= j.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-danger">Delete</button></form></td></tr><% }) %></tbody></table></section><section class="card p-5"><div class="metric-kicker">New timer</div><h3 class="mt-1 font-bold">Create scheduled job</h3><form class="mt-4 space-y-3" method="post" action="/cron/app/<%= app.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="field" name="name" placeholder="daily-report" required><input class="field font-mono text-xs" name="command" placeholder="node scripts/report.js" required><input class="field" name="schedule" value="daily" placeholder="daily atau *-*-* 03:30:00" required><button class="btn-primary w-full">Create timer</button></form></section></div><%- include('../partials/app-end') %>
