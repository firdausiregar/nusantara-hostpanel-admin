<%- include('../partials/app-start') %>
<div class="grid gap-6 xl:grid-cols-[.8fr_1.2fr]"><section class="card p-5 sm:p-6"><div class="metric-kicker">MariaDB</div><h2 class="mt-1 text-xl font-bold">Create database</h2><p class="mt-2 text-sm text-slate-500">Database dan user aplikasi dikelola terpisah dari akun administrator global.</p><form class="mt-5" method="post" action="/database"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="label">Database name</label><input class="field" name="name" placeholder="kabar_nusantara" required><button class="btn-primary mt-3 w-full" type="submit">Create database</button></form></section><section><div class="mb-4"><div class="metric-kicker">Databases</div><h2 class="mt-1 font-bold">Application databases</h2></div><% if(error){ %><div class="card border-red-400/20 p-4 text-sm text-red-200"><%= error %></div><% } %><div class="space-y-4"><% if(!databases.length){ %><div class="card p-6 text-sm text-slate-500">Belum ada database aplikasi.</div><% } %><% databases.forEach(db=>{ %><article class="card p-5"><div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start"><div><h3 class="font-bold"><%= db.name %></h3><div class="mt-2 flex flex-wrap gap-2"><span class="badge"><%= formatBytes(db.sizeBytes) %></span><% (db.users||[]).forEach(u=>{ %><span class="badge"><%= u %></span><% }) %></div></div><form method="post" action="/database/<%= db.name %>/users" class="flex gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="field !w-44" name="username" placeholder="app_user" required><button class="btn-secondary" type="submit">+ User</button></form></div><details class="mt-4 border-t border-white/[0.06] pt-4"><summary class="cursor-pointer text-xs font-semibold text-red-300">Danger zone</summary><form class="mt-3 flex gap-2" method="post" action="/database/<%= db.name %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="field" name="confirm_name" placeholder="Ketik <%= db.name %>" required><button class="btn-danger" type="submit">Drop</button></form></details></article><% }) %></div></section></div>
<%- include('../partials/app-end') %>
