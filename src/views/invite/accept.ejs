<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · <%= panelName %></title><link rel="stylesheet" href="/css/app.css?v=<%= release %>"></head><body><main class="mx-auto flex min-h-screen max-w-md items-center px-5 py-10"><section class="card w-full p-7"><div class="metric-kicker">Workspace invitation</div><h1 class="mt-2 text-2xl font-black"><%= invite.workspace_name %></h1><p class="mt-2 text-sm text-slate-500"><%= invite.email %> diundang sebagai <strong><%= invite.role %></strong>.</p><%- include('../partials/flash') %><form class="mt-6 space-y-4" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div><label class="label">Buat password</label><input class="field" type="password" name="password" autocomplete="new-password" required></div><button class="btn-primary w-full">Create account & join</button></form></section></main></body></html>
