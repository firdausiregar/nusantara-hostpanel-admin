<div data-sidebar-backdrop class="sidebar-backdrop hidden opacity-0" aria-hidden="true"></div>
<aside id="sidebar" data-sidebar aria-label="Navigasi utama" aria-hidden="true" class="app-sidebar fixed inset-y-0 left-0 z-40 flex -translate-x-full flex-col border-r border-white/[0.07] bg-ink-900/98 shadow-2xl shadow-black/40 backdrop-blur-2xl transition-transform duration-200 lg:w-72 lg:translate-x-0 lg:shadow-none">
  <div class="flex h-20 shrink-0 items-center border-b border-white/[0.07] px-4 sm:px-5">
    <a href="/" class="flex min-w-0 flex-1 items-center">
      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-gold-400/25 bg-gold-400/10 font-black text-gold-300">N</div>
      <div class="ml-3 min-w-0"><div class="truncate font-extrabold tracking-tight"><%= panelName %></div><div class="mt-0.5 flex items-center gap-2 text-[11px] text-slate-500"><span>Cloud Control Plane</span><span>v<%= release %></span></div></div>
    </a>
    <button data-sidebar-close class="btn-secondary !p-2.5 lg:hidden" type="button" aria-label="Tutup menu">✕</button>
  </div>

  <% if(permissions?.canDevelop && !permissions?.suspended){ %>
  <div class="shrink-0 px-3 pt-3">
    <a href="/apps/new" class="btn-primary w-full justify-between"><span>＋ New Project</span><span class="text-[10px] opacity-70">Git / Starter</span></a>
  </div>
  <% } %>

  <nav class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-3 pb-6" data-sidebar-nav>
    <% (navGroups||[]).forEach(([group,links], groupIndex) => { const gid = `nav-group-${groupIndex}`; const groupActive = links.some(([href]) => href==='/' ? currentPath==='/' : currentPath.startsWith(href)); %>
      <button type="button" class="nav-group-button" data-nav-group-toggle aria-controls="<%= gid %>" aria-expanded="true"><span><%= group %></span><span data-chevron class="transition-transform <%= groupActive?'text-gold-300':'' %>">⌃</span></button>
      <div id="<%= gid %>">
      <% links.forEach(([href,label,icon]) => { const active = href==='/' ? currentPath==='/' : currentPath.startsWith(href); %>
        <a href="<%= href %>" class="nav-link <%= active ? 'nav-link-active' : '' %>" <%= active?'aria-current="page"':'' %>><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl border border-white/[0.07] bg-white/[0.035] <%= active ? 'text-gold-300' : 'text-slate-500' %>"><%- iconSvg(icon,'h-4 w-4') %></span><span class="truncate"><%= label %></span></a>
      <% }) %>
      </div>
    <% }) %>
  </nav>
  <div class="mobile-safe-bottom shrink-0 border-t border-white/[0.07] bg-ink-900/95 p-4">
    <div class="mb-3 flex items-center justify-between gap-3"><div class="min-w-0"><div class="truncate text-xs font-semibold text-slate-300"><%= user?.email %></div><div class="mt-0.5 truncate text-[10px] uppercase tracking-wider text-slate-600"><%= workspace?.name || 'no workspace' %> · <% if(permissions?.isPlatformAdmin){ %>platform-admin · <%= runtimeMode %><% } else { %><%= workspaceRole || 'member' %><%= workspace?.status && workspace.status!=='active' ? ' · '+workspace.status : '' %><% } %></div></div><span class="h-2.5 w-2.5 shrink-0 rounded-full <%= localDevelopment ? 'bg-cyan-400' : 'bg-emerald-400' %>"></span></div>
    <% if(permissions?.suspended){ %><div class="mb-3 rounded-xl border border-amber-400/20 bg-amber-400/10 px-3 py-2 text-[11px] text-amber-200">Workspace suspended · mode baca saja.</div><% } %>
    <form method="post" action="/locale" class="mb-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="mb-1 block text-[10px] font-bold uppercase tracking-wider text-slate-600"><%= t('common.language','Language') %></label><select class="field !py-2 text-xs" name="locale" onchange="this.form.submit()"><% supportedLocales.forEach(l=>{ %><option value="<%= l %>" <%= locale===l?'selected':'' %>><%= l==='id'?'Bahasa Indonesia':'English' %></option><% }) %></select></form>
    <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-secondary w-full" type="submit">Keluar</button></form>
  </div>
</aside>
