<%- include('../partials/app-start') %>
<div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><div class="metric-kicker">SaaS tenancy</div><h2 class="mt-1 text-2xl font-black">Workspaces</h2><p class="mt-2 text-sm text-slate-500">Pisahkan project, domain, DNS, database, anggota tim, quota, dan lifecycle tenant.</p></div></div>
<div class="mt-6 grid gap-4 xl:grid-cols-2"><% items.forEach(w=>{ %><section class="card p-5"><div class="flex items-start justify-between gap-4"><div><h3 class="font-bold"><%= w.name %></h3><div class="mt-1 font-mono text-xs text-slate-500"><%= w.slug %> · <%= w.plan %></div></div><div class="flex gap-2"><span class="badge"><%= w.membership_role %></span><span class="<%= w.status==='active'?'badge-ok':'badge-bad' %>"><%= w.status||'active' %></span></div></div><div class="mt-4 grid grid-cols-2 gap-2 text-xs text-slate-500 sm:grid-cols-4"><div>Apps<br><b class="text-slate-300"><%= w.max_apps||'∞' %></b></div><div>Domains<br><b class="text-slate-300"><%= w.max_domains||'∞' %></b></div><div>DB<br><b class="text-slate-300"><%= w.max_databases||'∞' %></b></div><div>Storage<br><b class="text-slate-300"><%= w.max_storage_mb?`${w.max_storage_mb} MB`:'∞' %></b></div></div><div class="mt-4 flex gap-2"><% if(workspace?.id===w.id){ %><span class="badge-ok">Active workspace</span><% } else if(w.status!=='suspended'||isPlatformAdmin){ %><form method="post" action="/workspaces/<%= w.id %>/switch"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-secondary" type="submit">Switch</button></form><% } %></div><% if(isPlatformAdmin){ %><details class="mt-4 rounded-xl border border-white/[0.07] bg-black/15 p-4"><summary class="cursor-pointer text-xs font-semibold text-slate-400">Platform policy & quota</summary><form class="mt-4 grid gap-3 sm:grid-cols-2" method="post" action="/workspaces/<%= w.id %>/policy"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div><label class="label">Plan</label><input class="field" name="plan" value="<%= w.plan %>" required></div><div><label class="label">Status</label><select class="field" name="status"><option value="active" <%= w.status==='active'?'selected':'' %>>active</option><option value="suspended" <%= w.status==='suspended'?'selected':'' %>>suspended</option></select></div><div><label class="label">Max apps (0 = unlimited)</label><input class="field" type="number" min="0" name="max_apps" value="<%= w.max_apps||0 %>"></div><div><label class="label">Max domains</label><input class="field" type="number" min="0" name="max_domains" value="<%= w.max_domains||0 %>"></div><div><label class="label">Max databases</label><input class="field" type="number" min="0" name="max_databases" value="<%= w.max_databases||0 %>"></div><div><label class="label">Max storage MB</label><input class="field" type="number" min="0" name="max_storage_mb" value="<%= w.max_storage_mb||0 %>"></div><div class="sm:col-span-2"><button class="btn-secondary" type="submit">Save policy</button></div></form></details><% } %></section><% }) %></div>
<section class="card mt-6 p-5"><div class="metric-kicker">New tenant</div><h3 class="mt-1 font-bold">Create workspace</h3><form class="mt-4 grid gap-4 sm:grid-cols-2" method="post" action="/workspaces"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div><label class="label">Name</label><input class="field" name="name" required></div><div><label class="label">Slug</label><input class="field" name="slug" placeholder="team-name"></div><div class="sm:col-span-2"><button class="btn-primary">Create workspace</button></div></form></section>
<%- include('../partials/app-end') %>
