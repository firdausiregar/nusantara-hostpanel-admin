<%- include('../partials/app-start') %>
<div class="grid gap-6 xl:grid-cols-[1.05fr_.95fr]">
<section class="space-y-4">
  <div class="card p-5 sm:p-6"><div class="flex items-start gap-4"><div class="flex h-11 w-11 items-center justify-center rounded-2xl border border-white/10 bg-white/[.04] text-white"><%- iconSvg('git-branch','h-5 w-5') %></div><div class="min-w-0 flex-1"><div class="metric-kicker">Source control</div><h2 class="mt-1 text-xl font-black"><%= t('github.title','GitHub') %></h2><p class="mt-2 text-sm text-slate-500">OAuth untuk identitas/repository user dan GitHub App untuk akses repository private yang lebih granular.</p></div></div>
  <% if(appConnection){ %><div class="mt-5 rounded-2xl border border-emerald-400/20 bg-emerald-400/5 p-4"><div class="flex items-center justify-between gap-3"><div><div class="font-bold">GitHub App · <%= appConnection.account_login %></div><div class="mt-1 text-xs text-slate-500">Installation terhubung. Token installation dibuat sementara saat API/deploy membutuhkan akses.</div></div><span class="badge-ok"><%= t('common.connected','Connected') %></span></div><form class="mt-4" method="post" action="/integrations/github/app/disconnect"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-danger"><%= t('common.disconnect','Disconnect') %></button></form></div>
  <% } else if(appReady){ %><a class="btn-primary mt-5 w-full justify-center" href="/integrations/github/app/install"><%- iconSvg('plug','h-4 w-4') %><span class="ml-2"><%= t('github.app','Install GitHub App') %></span></a><p class="mt-2 text-xs text-slate-600"><%= t('github.privateHint','GitHub App is recommended for private repositories.') %></p><% } %>
  <% if(connection){ %><div class="mt-4 rounded-2xl border border-cyan-400/20 bg-cyan-400/5 p-4"><div class="flex items-center justify-between gap-4"><div><div class="font-bold">OAuth/PAT · @<%= connection.account_login %></div><div class="mt-1 text-xs text-slate-500">Credential disimpan terenkripsi dalam vault.</div></div><span class="badge-ok"><%= t('common.connected','Connected') %></span></div><form class="mt-4" method="post" action="/integrations/github/disconnect"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-danger"><%= t('common.disconnect','Disconnect') %></button></form></div><% } else { %><div class="mt-4 grid gap-3 sm:grid-cols-2"><% if(oauthReady){ %><a class="btn-secondary justify-center" href="/integrations/github/oauth"><%= t('github.oauth','Connect GitHub OAuth') %></a><% } %><details class="rounded-xl border border-white/[.08] p-4"><summary class="cursor-pointer text-sm font-semibold">Fine-grained PAT</summary><form class="mt-4 space-y-3" method="post" action="/integrations/github/connect"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="field" type="password" name="token" autocomplete="new-password" placeholder="github_pat_…" required><button class="btn-secondary w-full">Connect securely</button></form></details></div><% } %>
  <% if(error){ %><div class="mt-4 badge-bad"><%= error %></div><% } %></div>
</section>
<section class="card p-5 sm:p-6"><div class="metric-kicker">Repository access</div><div class="flex items-center justify-between gap-3"><h3 class="mt-1 font-bold"><%= t('github.repos','Available repositories') %></h3><span class="badge"><%= repos.length %></span></div><div class="mt-4 space-y-2 overflow-auto pr-1" style="max-height:620px"><% if(!repos.length){ %><p class="text-sm text-slate-500">Hubungkan GitHub untuk menampilkan repository.</p><% } repos.forEach(repo=>{ %><div class="repo-card"><div class="min-w-0 flex-1"><div class="truncate font-semibold"><%= repo.full_name %></div><div class="mt-1 flex flex-wrap gap-2 text-[11px] text-slate-600"><span><%= repo.private?'Private':'Public' %></span><span><%= repo.language||'—' %></span><span><%= repo.default_branch %></span></div><% if(repo.description){ %><div class="mt-1 text-xs text-slate-500"><%= repo.description %></div><% } %></div><a class="btn-primary !px-3 !py-2 text-xs" href="/apps/new?repo=<%= encodeURIComponent(repo.full_name) %>"><%= t('common.import','Import') %></a></div><% }) %></div></section>
</div>
<%- include('../partials/app-end') %>
