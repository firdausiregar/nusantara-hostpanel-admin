<%- include('../partials/app-start') %>
<div class="grid gap-4 md:grid-cols-3">
  <section class="metric"><div class="metric-kicker">Current plan</div><div class="metric-value"><%= subscription?.plan_name||workspace?.plan||'Self-hosted' %></div><div class="mt-2 text-xs text-slate-500"><%= subscription?.status||workspace?.status||'active' %></div></section>
  <section class="metric"><div class="metric-kicker">Projects quota</div><div class="metric-value"><%= subscription?.max_apps||workspace?.max_apps||'∞' %></div></section>
  <section class="metric"><div class="metric-kicker">Storage quota</div><div class="metric-value"><%= subscription?.max_storage_mb?`${subscription.max_storage_mb} MB`:(workspace?.max_storage_mb?`${workspace.max_storage_mb} MB`:'∞') %></div></section>
</div>
<% if(subscription?.provider_subscription_id){ %><div class="mt-4 card flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between"><div><div class="metric-kicker">Midtrans recurring</div><div class="mt-1 font-semibold"><%= subscription.provider_subscription_id %></div><div class="mt-1 text-xs text-slate-500">Provider: <%= subscription.provider %> · status <%= subscription.status %></div></div><form method="post" action="/billing/recurring/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="enabled" value="<%= subscription.status==='active'?0:1 %>"><button class="btn-secondary"><%= subscription.status==='active'?'Disable auto-renew':'Enable auto-renew' %></button></form></div><% } else if(midtransReady && subscription?.provider==='midtrans' && permissions?.canWorkspaceAdmin){ %><div class="mt-4 card flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between"><div><div class="metric-kicker">Auto-renew</div><div class="mt-1 font-semibold">Midtrans Subscription API</div><div class="mt-1 text-xs text-slate-500">Aktifkan setelah checkout pertama menyimpan token pembayaran recurring yang didukung.</div></div><form method="post" action="/billing/recurring"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-primary">Enable auto-renew</button></form></div><% } %>
<div class="mt-6 grid gap-6 xl:grid-cols-[1.1fr_.9fr]">
<section>
  <div class="flex items-end justify-between gap-3"><div><div class="metric-kicker">Midtrans</div><h2 class="mt-1 text-xl font-black"><%= t('billing.title','Billing & Plans') %></h2></div><span class="<%= midtransReady?'badge-ok':'badge-warn' %>"><%= midtransReady?'Midtrans ready':'Midtrans not configured' %></span></div>
  <% if(!midtransReady){ %><div class="mt-4 rounded-2xl border border-amber-400/20 bg-amber-400/5 p-4 text-sm text-amber-100"><%= t('billing.notConfigured','Midtrans belum dikonfigurasi oleh platform admin.') %></div><% } %>
  <div class="mt-4 grid gap-3 sm:grid-cols-2"><% plans.filter(p=>p.active).forEach(p=>{ %>
    <div class="card relative overflow-hidden p-5"><div class="flex items-start justify-between gap-3"><div><h3 class="font-bold"><%= p.name %></h3><div class="mt-1 text-xs text-slate-600"><%= p.code %></div></div><span class="badge"><%= p.monthly_price_cents?`${p.currency} ${(p.monthly_price_cents/100).toLocaleString(locale==='id'?'id-ID':'en-US')}/mo`:'Custom/Free' %></span></div><div class="mt-4 grid grid-cols-2 gap-2 text-xs text-slate-500"><div>Projects <b class="text-slate-300"><%= p.max_apps||'∞' %></b></div><div>Domains <b class="text-slate-300"><%= p.max_domains||'∞' %></b></div><div>DB <b class="text-slate-300"><%= p.max_databases||'∞' %></b></div><div>Storage <b class="text-slate-300"><%= p.max_storage_mb?`${p.max_storage_mb} MB`:'∞' %></b></div></div>
    <% if(midtransReady && p.monthly_price_cents>0 && permissions?.canWorkspaceAdmin && !permissions?.suspended){ %><form method="post" action="/billing/checkout" class="mt-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="plan_id" value="<%= p.id %>"><button class="btn-primary w-full" type="submit"><%- iconSvg('credit-card','h-4 w-4') %><span class="ml-2"><%= t('billing.checkout','Pay with Midtrans') %></span></button></form><% } %>
    </div><% }) %></div>
</section>
<section><div class="metric-kicker"><%= t('billing.history','Payment history') %></div><h2 class="mt-1 font-bold">Transactions & invoices</h2><div class="mt-4 space-y-2"><% if(!transactions.length&&!invoices.length){ %><div class="card p-5 text-sm text-slate-500">Belum ada pembayaran.</div><% } transactions.forEach(tx=>{ %><div class="card p-4"><div class="flex items-start justify-between gap-3"><div class="min-w-0"><div class="truncate font-semibold"><%= tx.plan_name||tx.order_id %></div><div class="mt-1 text-xs text-slate-600"><%= tx.order_id %> · IDR <%= Number(tx.gross_amount||0).toLocaleString('id-ID') %></div><div class="mt-1 text-[11px] text-slate-600"><%= tx.payment_type||'—' %> · <%= tx.created_at %></div></div><span class="<%= ['settlement','capture'].includes(tx.transaction_status)?'badge-ok':tx.transaction_status==='created'||tx.transaction_status==='pending'?'badge-warn':'badge' %>"><%= tx.transaction_status %></span></div><div class="mt-3 flex flex-wrap gap-2"><form method="post" action="/billing/transactions/<%= tx.id %>/reconcile"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-secondary !py-2 text-xs">Refresh status</button></form><% if(['created','pending'].includes(tx.transaction_status)){ %><form method="post" action="/billing/transactions/<%= tx.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-danger !py-2 text-xs" data-confirm="Batalkan transaksi ini di Midtrans?">Cancel</button></form><% } %><% if(isPlatformAdmin && ['settlement','capture'].includes(tx.transaction_status)){ %><form method="post" action="/billing/transactions/<%= tx.id %>/refund"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="reason" value="HostPanel platform refund"><button class="btn-danger !py-2 text-xs" data-confirm="Kirim refund ke Midtrans? Tindakan ini menyangkut dana nyata.">Refund</button></form><% } %></div></div><% }) %></div></section>
</div>
<% if(isPlatformAdmin){ %><details class="card mt-6 p-5 sm:p-6"><summary class="cursor-pointer font-bold">Platform billing administration</summary><div class="mt-5 grid gap-6 xl:grid-cols-2"><form class="space-y-3" method="post" action="/billing/subscription"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h3 class="font-semibold">Assign plan / lifecycle</h3><select class="field" name="workspace_id"><% allWorkspaces.forEach(w=>{ %><option value="<%= w.id %>"><%= w.name %></option><% }) %></select><select class="field" name="plan_id"><% plans.forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select><select class="field" name="status"><option>trialing</option><option selected>active</option><option>past_due</option><option>grace</option><option>suspended</option><option>cancelled</option></select><input class="field" type="number" name="period_days" value="30" min="1"><button class="btn-primary">Apply subscription</button></form><form class="space-y-3" method="post" action="/billing/plans"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h3 class="font-semibold">Create / update plan</h3><div class="grid grid-cols-2 gap-3"><input class="field" name="code" placeholder="business" required><input class="field" name="name" placeholder="Business" required></div><div class="grid grid-cols-2 gap-3"><input class="field" type="number" name="monthly_price_cents" placeholder="Price minor units"><input class="field" name="currency" value="IDR"></div><div class="grid grid-cols-2 gap-3"><input class="field" type="number" name="max_apps" placeholder="Apps"><input class="field" type="number" name="max_domains" placeholder="Domains"><input class="field" type="number" name="max_databases" placeholder="DB"><input class="field" type="number" name="max_storage_mb" placeholder="Storage MB"></div><input type="hidden" name="active" value="1"><button class="btn-secondary">Save plan</button></form></div></details><% } %>
<%- include('../partials/app-end') %>
