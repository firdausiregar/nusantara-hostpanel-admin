<%- include('../partials/app-start') %>
<div><div class="metric-kicker">SaaS access</div><h2 class="mt-1 text-2xl font-black">Team & Access</h2><p class="mt-2 text-sm text-slate-500">Workspace <strong class="text-white"><%= workspace?.name %></strong>. Role owner/admin mengelola tim; developer mengelola project; viewer read-only.</p></div>
<% if(inviteUrl){ %><div class="card mt-5 border-gold-400/20 p-5"><div class="metric-kicker">Invite link · shown once</div><input class="field mt-3 font-mono text-xs" readonly value="<%= inviteUrl %>"><p class="mt-2 text-xs text-slate-500">Link berlaku 7 hari. Kirim melalui kanal aman.</p></div><% } %>
<div class="mt-6 grid gap-6 xl:grid-cols-[1.4fr_.8fr]"><section class="table-wrap"><table class="table"><thead><tr><th>User</th><th>Role</th><th>Last login</th><th></th></tr></thead><tbody><% members.forEach(m=>{ %><tr><td><div class="font-semibold"><%= m.email %></div><div class="text-xs text-slate-600"><%= m.display_name||'' %></div></td><td><span class="badge"><%= m.role %></span></td><td class="text-xs text-slate-500"><%= m.last_login_at||'-' %></td><td class="text-right"><% if(m.role!=='owner' && (user?.role==='admin'||workspaceRole==='owner'||workspaceRole==='admin')){ %><form class="inline-flex gap-2" method="post" action="/team/<%= m.id %>/role"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select class="field !w-auto" name="role"><% ['admin','developer','viewer'].forEach(r=>{ %><option value="<%= r %>" <%= m.role===r?'selected':'' %>><%= r %></option><% }) %></select><button class="btn-secondary">Save</button></form><form class="ml-2 inline" method="post" action="/team/<%= m.id %>/remove"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-danger" data-confirm="Hapus anggota dari workspace?">Remove</button></form><% } %></td></tr><% }) %></tbody></table></section><section class="card p-5"><div class="metric-kicker">Invite</div><h3 class="mt-1 font-bold">Add teammate</h3><form class="mt-4 space-y-4" method="post" action="/team/invite"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div><label class="label">Email</label><input class="field" type="email" name="email" required></div><div><label class="label">Role</label><select class="field" name="role"><option>developer</option><option>viewer</option><option>admin</option></select></div><button class="btn-primary w-full">Create invite link</button></form><div class="mt-6 border-t border-white/[.08] pt-4"><div class="text-xs font-semibold text-slate-300">Pending invites</div><% if(!invites.length){ %><p class="mt-2 text-xs text-slate-600">None.</p><% } %><% invites.forEach(i=>{ %><div class="mt-2 rounded-xl border border-white/[.06] p-3 text-xs"><div><%= i.email %> · <%= i.role %></div><div class="mt-1 text-slate-600">expires <%= i.expires_at %></div></div><% }) %></div></section></div>
<%- include('../partials/app-end') %>
