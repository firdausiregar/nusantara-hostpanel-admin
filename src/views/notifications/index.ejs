<%- include('../partials/app-start') %>
<div class="grid gap-6 xl:grid-cols-[1.2fr_.8fr]">
<section>
  <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"><div><div class="metric-kicker">Inbox</div><h2 class="mt-1 text-xl font-bold"><%= t('notifications.title','Notifications') %></h2></div><div class="flex flex-wrap gap-2"><form method="post" action="/notifications/read-all"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-secondary" type="submit"><%= t('notifications.markAll','Mark all read') %></button></form><form method="post" action="/notifications/delete-read"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-secondary" type="submit" data-confirm="Hapus semua notifikasi yang sudah dibaca?"><%= t('notifications.deleteRead','Delete read') %></button></form><form method="post" action="/notifications/delete-all"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-danger" type="submit" data-confirm="Hapus SEMUA notifikasi workspace ini?"><%= t('notifications.deleteAll','Delete all') %></button></form></div></div>
  <form method="post" action="/notifications/delete-selected"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="space-y-3"><% if(!notifications.length){ %><div class="card p-6 text-sm text-slate-500"><%= t('notifications.empty','No notifications yet.') %></div><% } %><% notifications.forEach(n=>{ %><article class="card p-4 sm:p-5 <%= n.read_at?'opacity-70':'' %>"><div class="flex items-start gap-3"><input class="mt-1 h-4 w-4 rounded border-white/20 bg-transparent" type="checkbox" name="ids" value="<%= n.id %>" aria-label="Select notification"><div class="min-w-0 flex-1"><div class="flex flex-wrap items-center gap-2"><span class="<%= n.level==='critical'?'badge-bad':n.level==='warn'?'badge-warn':n.level==='success'?'badge-ok':'badge' %>"><%= n.level %></span><h3 class="font-bold"><%= n.title %></h3></div><p class="mt-2 whitespace-pre-wrap break-words text-sm text-slate-400"><%= n.message %></p><p class="mt-2 text-xs text-slate-600"><%= n.created_at %> · <%= n.type %></p></div><div class="flex shrink-0 flex-col gap-2"><% if(!n.read_at){ %><button class="btn-secondary !px-3 !py-2 text-xs" type="submit" formaction="/notifications/<%= n.id %>/read" formmethod="post"><%= t('common.read','Read') %></button><% } %><button class="btn-danger !px-3 !py-2 text-xs" type="submit" formaction="/notifications/<%= n.id %>/delete" formmethod="post" data-confirm="Hapus notifikasi ini?"><%- iconSvg('trash-2','h-4 w-4') %></button></div></div></article><% }) %></div><% if(notifications.length){ %><div class="sticky bottom-20 mt-4 flex justify-end lg:bottom-4"><button class="btn-danger shadow-xl" type="submit" data-confirm="Hapus notifikasi yang dipilih?"><%- iconSvg('trash-2','h-4 w-4') %><span class="ml-2">Hapus dipilih</span></button></div><% } %></form>
</section>
<section class="card h-fit p-5 sm:p-6"><div class="metric-kicker">Delivery</div><h2 class="mt-1 text-xl font-bold">Notification channels</h2><p class="mt-2 text-sm text-slate-500">Inbox web selalu aktif. Credential channel eksternal disimpan terenkripsi.</p><div class="mt-4 space-y-2"><% channels.forEach(c=>{ %><div class="rounded-xl border border-white/[0.07] p-3"><div class="flex items-center justify-between gap-3"><div><div class="font-semibold"><%= c.name %></div><div class="text-xs text-slate-600"><%= c.type %></div></div><div class="flex gap-2"><form method="post" action="/notifications/channels/<%= c.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="enabled" value="<%= c.enabled?0:1 %>"><button class="btn-secondary" type="submit"><%= c.enabled?'Disable':'Enable' %></button></form><form method="post" action="/notifications/channels/<%= c.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-danger" type="submit" data-confirm="Hapus notification channel?"><%= t('common.delete','Delete') %></button></form></div></div></div><% }) %></div><details class="mt-5 border-t border-white/[0.07] pt-4"><summary class="cursor-pointer font-semibold">Add channel</summary><form method="post" action="/notifications/channels" class="mt-4 space-y-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="label">Type</label><select class="field" name="type"><option value="webhook">HTTPS Webhook</option><option value="telegram">Telegram</option><option value="email">Email (global SMTP)</option></select><label class="label">Name</label><input class="field" name="name" required><label class="label">Webhook URL</label><input class="field" name="url" placeholder="https://hooks.example.com/..."><label class="label">Telegram bot token</label><input class="field" type="password" name="bot_token"><label class="label">Telegram chat ID</label><input class="field" name="chat_id"><label class="label">Email destination</label><input class="field" name="to" type="email"><button class="btn-primary w-full" type="submit"><%= t('common.save','Save') %></button></form></details><form method="post" action="/notifications/test" class="mt-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-secondary w-full" type="submit">Send test</button></form></section>
</div>
<%- include('../partials/app-end') %>
