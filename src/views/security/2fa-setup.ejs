<%- include('../partials/app-start') %><section class="mx-auto max-w-2xl card p-6"><div class="metric-kicker">Two-factor authentication</div><h2 class="mt-1 text-2xl font-black">Aktifkan TOTP</h2><p class="mt-3 text-sm text-slate-500">Tambahkan secret berikut ke Aegis, Google Authenticator, 1Password, Bitwarden, atau aplikasi TOTP lain.</p><div class="mt-4 rounded-xl border border-white/[.08] bg-black/20 p-4"><div class="label">Secret</div><code class="break-all"><%= secret %></code><div class="label mt-4">otpauth URI</div><textarea class="field min-h-28 font-mono text-xs" readonly><%= uri %></textarea></div><form class="mt-5 flex gap-3" method="post" action="/security/2fa/enable"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="field" name="code" placeholder="123456" inputmode="numeric" required><button class="btn-primary">Verify & enable</button></form></section><%- include('../partials/app-end') %>
