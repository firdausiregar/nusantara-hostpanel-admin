<%- include('../partials/app-start') %>
<div><div class="metric-kicker">Identity & access</div><h2 class="mt-1 text-2xl font-black">Security Center</h2><p class="mt-2 text-sm text-slate-500">2FA, session revocation, API token, dan security events untuk akun <%= current.email %>.</p></div>
<div class="mt-6 grid gap-6 xl:grid-cols-2"><section class="card p-5"><div class="flex items-center justify-between"><div><div class="metric-kicker">Two-factor authentication</div><h3 class="mt-1 font-bold">TOTP authenticator</h3></div><span class="<%= current.totp_enabled?'badge-ok':'badge-warn' %>"><%= current.totp_enabled?'ENABLED':'DISABLED' %></span></div><p class="mt-3 text-sm leading-6 text-slate-500">TOTP RFC-compatible tanpa layanan pihak ketiga. Recovery code sekali pakai disimpan sebagai fingerprint terenkripsi.</p><% if(!current.totp_enabled){ %><form class="mt-4" method="post" action="/security/2fa/begin"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-primary">Setup 2FA</button></form><% } else { %><form class="mt-4 flex gap-2" method="post" action="/security/2fa/disable"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="field" type="password" name="current_password" placeholder="Current password" required><button class="btn-danger">Disable</button></form><% } %></section>
<section class="card p-5"><div class="metric-kicker">API</div><h3 class="mt-1 font-bold">Personal access token</h3><form class="mt-4 grid gap-3 sm:grid-cols-2" method="post" action="/security/tokens"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="field" name="name" placeholder="CI deploy" required><select class="field" name="scopes"><option value="read">read</option><option value="read,deploy">read,deploy</option><option value="read,deploy,apps:write">read,deploy,apps:write</option></select><input class="field" name="days" type="number" value="90" min="1" max="365"><button class="btn-primary">Create token</button></form><div class="mt-4 space-y-2"><% tokens.forEach(t=>{ %><div class="rounded-xl border border-white/[.07] p-3 text-xs"><div class="flex justify-between gap-3"><div><strong><%= t.name %></strong> · <code><%= t.token_prefix %>…</code><div class="mt-1 text-slate-600"><%= t.scopes %> · expires <%= t.expires_at||'never' %></div></div><% if(!t.revoked_at){ %><form method="post" action="/security/tokens/<%= t.id %>/revoke"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-danger">Revoke</button></form><% } %></div></div><% }) %></div></section></div>
<section class="card mt-6 overflow-hidden"><div class="flex items-center justify-between p-5"><div><div class="metric-kicker">Sessions</div><h3 class="mt-1 font-bold">Active & recent sessions</h3></div><form method="post" action="/security/sessions/revoke-others"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-secondary">Revoke all others</button></form></div><div class="table-wrap border-0"><table class="table"><thead><tr><th>IP</th><th>User agent</th><th>Last seen</th><th>Status</th><th></th></tr></thead><tbody><% sessions.forEach(s=>{ %><tr><td class="font-mono text-xs"><%= s.ip||'-' %></td><td class="max-w-md truncate text-xs"><%= s.user_agent||'-' %></td><td class="text-xs"><%= s.last_seen_at %></td><td><span class="<%= s.revoked_at?'badge-bad':'badge-ok' %>"><%= s.revoked_at?'REVOKED':'ACTIVE' %></span></td><td class="text-right"><% if(!s.revoked_at&&s.id!==locals?.securitySessionId){ %><form method="post" action="/security/sessions/<%= s.id %>/revoke"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-danger">Revoke</button></form><% } %></td></tr><% }) %></tbody></table></div></section>
<section class="card mt-6 overflow-hidden"><div class="p-5"><div class="metric-kicker">Security events</div><h3 class="mt-1 font-bold">Recent activity</h3></div><div class="table-wrap border-0"><table class="table"><thead><tr><th>Time</th><th>Severity</th><th>Event</th><th>IP</th><th>Detail</th></tr></thead><tbody><% events.forEach(e=>{ %><tr><td class="text-xs"><%= e.created_at %></td><td><span class="<%= e.severity==='critical'?'badge-bad':e.severity==='warn'?'badge-warn':'badge' %>"><%= e.severity %></span></td><td><%= e.event %></td><td class="font-mono text-xs"><%= e.ip||'-' %></td><td class="max-w-lg truncate text-xs text-slate-500"><%= e.detail||'-' %></td></tr><% }) %></tbody></table></div></section>
<%- include('../partials/app-end') %>
