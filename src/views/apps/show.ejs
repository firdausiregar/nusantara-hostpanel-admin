<%- include('../partials/app-start') %>
<% const active=runtime?.activeState==='active'; const healthy=Boolean(health?.ok); %>
<section class="relative overflow-hidden rounded-3xl border border-white/[0.08] bg-gradient-to-br from-white/[0.06] to-white/[0.015] p-6 sm:p-8">
  <div class="absolute -right-20 -top-24 h-64 w-64 rounded-full bg-cyan-400/[0.05] blur-3xl"></div>
  <div class="relative flex flex-col justify-between gap-6 xl:flex-row xl:items-end">
    <div class="min-w-0"><div class="metric-kicker">Project overview</div><div class="mt-2 flex flex-wrap items-center gap-2"><h2 class="truncate text-2xl font-black tracking-tight sm:text-3xl"><%= app.name %></h2><span class="<%= active?'badge-ok':'badge-warn' %>"><%= String(runtime?.activeState||'unknown').toUpperCase() %></span><span class="<%= healthy?'badge-ok':'badge-bad' %>"><%= healthy?'HEALTHY':'UNHEALTHY' %></span></div><p class="mt-2 font-mono text-xs text-slate-500"><%= app.slug %> · <%= app.working_dir %></p></div>
    <div class="flex flex-wrap gap-2"><% if(user?.role==='admin'){ %><% if(!active){ %><form method="post" action="/apps/<%= app.id %>/action/start"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-primary" type="submit">Start</button></form><% } else { %><form method="post" action="/apps/<%= app.id %>/action/stop"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-secondary" type="submit">Stop</button></form><% } %><form method="post" action="/apps/<%= app.id %>/action/restart"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-secondary" type="submit">Restart</button></form><% if(app.git_repo){ %><form method="post" action="/apps/<%= app.id %>/deploy"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-primary" data-confirm="Deploy branch <%= app.git_branch||'main' %>?" type="submit">Deploy</button></form><% } %><% } %><a class="btn-secondary" href="/apps/<%= app.id %>/logs">Logs</a><a class="btn-secondary" href="/apps">← Projects</a></div>
  </div>
</section>

<nav class="mt-4 flex gap-2 overflow-x-auto rounded-2xl border border-white/[0.07] bg-white/[0.025] p-2 text-xs font-semibold">
  <a class="btn-secondary whitespace-nowrap" href="/apps/<%= app.id %>">Overview</a>
  <a class="btn-secondary whitespace-nowrap" href="/deployments?app=<%= app.id %>">Deployments</a>
  <a class="btn-secondary whitespace-nowrap" href="/environments/app/<%= app.id %>">Environment</a>
  <a class="btn-secondary whitespace-nowrap" href="/workers/app/<%= app.id %>">Workers</a>
  <a class="btn-secondary whitespace-nowrap" href="/cron/app/<%= app.id %>">Cron</a>
  <a class="btn-secondary whitespace-nowrap" href="/files/app/<%= app.id %>">Files</a>
  <a class="btn-secondary whitespace-nowrap" href="/apps/<%= app.id %>/logs">Runtime logs</a>
</nav>

<div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
  <div class="metric"><div class="metric-kicker">Port</div><div class="metric-value !text-2xl"><%= app.port %></div><div class="mt-1 text-xs text-slate-600">loopback</div></div>
  <div class="metric"><div class="metric-kicker">PID</div><div class="metric-value !text-2xl"><%= runtime?.pid||'-' %></div><div class="mt-1 text-xs text-slate-600"><%= runtime?.subState||'-' %></div></div>
  <div class="metric"><div class="metric-kicker">Health</div><div class="metric-value !text-2xl"><%= health?.statusCode||'-' %></div><div class="mt-1 text-xs text-slate-600"><%= health?.latencyMs!=null?health.latencyMs+' ms':(health?.error||app.health_path||'/') %></div></div>
  <div class="metric"><div class="metric-kicker">Runtime</div><div class="metric-value !text-2xl"><%= (app.start_mode||'node').toUpperCase() %></div><div class="mt-1 text-xs text-slate-600"><%= app.restart_policy||'on-failure' %></div></div>
  <div class="metric"><div class="metric-kicker">Last release</div><div class="metric-value !text-2xl"><%= app.last_deployed_commit?app.last_deployed_commit.slice(0,8):'-' %></div><div class="mt-1 text-xs text-slate-600"><%= app.last_deployed_at||'not deployed' %></div></div>
</div>

<div class="mt-6 grid gap-6 xl:grid-cols-[1fr_1fr]">
  <section class="card p-5 sm:p-6"><div class="metric-kicker">Routing</div><h3 class="mt-1 font-bold">Domains</h3><div class="mt-4 space-y-3"><% if(!domains.length){ %><p class="text-sm text-slate-600">Belum ada domain untuk project ini.</p><% } %><% domains.forEach(d=>{ %><div class="flex flex-col justify-between gap-2 rounded-xl border border-white/[0.07] bg-black/15 p-4 sm:flex-row sm:items-center"><div class="min-w-0"><div class="truncate font-semibold"><%= d.hostname %></div><div class="mt-1 text-xs text-slate-600">127.0.0.1:<%= d.target_port %></div></div><span class="<%= d.ssl_enabled?'badge-ok':'badge' %>"><%= d.ssl_enabled?'HTTPS':'HTTP' %></span></div><% }) %></div><div class="mt-4"><a class="btn-secondary" href="/domains">Kelola domain</a></div></section>
  <section class="card p-5 sm:p-6"><div class="metric-kicker">Source</div><h3 class="mt-1 font-bold">Build & runtime</h3><dl class="mt-4 space-y-3 text-sm"><div class="flex justify-between gap-4"><dt class="text-slate-500">Repository</dt><dd class="max-w-[65%] truncate text-right font-mono text-xs"><%= app.git_repo||'manual source' %></dd></div><div class="flex justify-between gap-4"><dt class="text-slate-500">Branch</dt><dd class="font-mono text-xs"><%= app.git_branch||'-' %></dd></div><div class="flex justify-between gap-4"><dt class="text-slate-500">Build</dt><dd class="font-mono text-xs"><%= app.build_script||'none' %></dd></div><div class="flex justify-between gap-4"><dt class="text-slate-500">Health path</dt><dd class="font-mono text-xs"><%= app.health_path||'/' %></dd></div><div class="flex justify-between gap-4"><dt class="text-slate-500">Service</dt><dd class="font-mono text-xs"><%= app.service_name %></dd></div><div class="flex justify-between gap-4"><dt class="text-slate-500">Resource guard</dt><dd class="text-right text-xs"><%= app.memory_limit_mb?app.memory_limit_mb+' MB RAM · ':'' %><%= app.cpu_quota_percent?app.cpu_quota_percent+'% CPU · ':'' %><%= app.tasks_max?app.tasks_max+' tasks':(!app.memory_limit_mb&&!app.cpu_quota_percent?'default':'') %></dd></div></dl></section>
</div>

<% if(app.git_repo){ %>
<section class="card mt-6 p-5 sm:p-6"><div class="flex flex-col justify-between gap-4 lg:flex-row lg:items-center"><div><div class="metric-kicker">Git automation</div><h3 class="mt-1 font-bold">GitHub webhook & private repository</h3><p class="mt-2 text-sm text-slate-500">Credential repository disimpan terenkripsi. Webhook menerima signature HMAC valid; aktifkan event GitHub <b>Pushes</b> dan <b>Pull requests</b> agar auto-deploy + PR Preview bekerja.</p></div><div class="flex flex-wrap gap-2"><span class="<%= hasGitCredential?'badge-ok':'badge' %>"><%= hasGitCredential?'PRIVATE CREDENTIAL':'PUBLIC / NO TOKEN' %></span><span class="<%= app.auto_deploy?'badge-ok':'badge-warn' %>"><%= app.auto_deploy?'AUTO DEPLOY ON':'AUTO DEPLOY OFF' %></span></div></div><div class="mt-4 flex flex-wrap items-center gap-2"><% if(webhook?.enabled){ %><span class="badge-ok">Webhook active</span><code class="rounded-lg bg-black/25 px-3 py-2 text-xs text-slate-400"><%= webhook.public_id %></code><% if(user?.role==='admin'||workspaceRole==='admin'||workspaceRole==='owner'){ %><form method="post" action="/apps/<%= app.id %>/webhook/disable"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-secondary" type="submit">Disable webhook</button></form><form method="post" action="/apps/<%= app.id %>/webhook"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-secondary" type="submit" data-confirm="Rotate GitHub webhook secret? Webhook lama akan berhenti bekerja.">Rotate secret</button></form><% } %><% } else if(user?.role==='admin'||workspaceRole==='admin'||workspaceRole==='owner'){ %><form method="post" action="/apps/<%= app.id %>/webhook"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-primary" type="submit">Create GitHub webhook</button></form><% } %></div></section>
<% } %>

<section class="card mt-6 overflow-hidden"><div class="flex items-center justify-between gap-4 p-5 sm:p-6"><div><div class="metric-kicker">Activity</div><h3 class="mt-1 font-bold">Deployment history</h3></div><a class="text-xs font-semibold text-gold-300" href="/deployments">All deployments →</a></div><div class="table-wrap border-0"><table class="table"><thead><tr><th>Status</th><th>Commit</th><th>Branch</th><th>Started</th><th>Message</th></tr></thead><tbody><% if(!deployments.length){ %><tr><td colspan="5" class="text-slate-600">Belum ada deployment.</td></tr><% } %><% deployments.forEach(d=>{ %><tr><td><span class="<%= d.status==='success'?'badge-ok':d.status==='failed'?'badge-bad':'badge-warn' %>"><%= d.status %></span></td><td class="font-mono text-xs"><%= d.commit_sha?d.commit_sha.slice(0,10):'-' %></td><td><%= d.branch||'-' %></td><td class="text-xs text-slate-500"><%= d.started_at %></td><td class="max-w-sm truncate text-xs text-slate-500"><%= d.message||'-' %></td></tr><% }) %></tbody></table></div></section>
<%- include('../partials/app-end') %>
