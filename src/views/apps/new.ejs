<%- include('../partials/app-start') %>
<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"><div><div class="metric-kicker">Git → Build → Deploy</div><h2 class="mt-1 text-2xl font-black">Create a new project</h2><p class="mt-2 max-w-2xl text-sm text-slate-500">Pilih repository atau starter. HostPanel mengisi konfigurasi umum otomatis; Advanced Settings tetap tersedia bila kamu ingin kontrol penuh.</p></div><a href="/integrations" class="btn-secondary">GitHub connection</a></div>

<form method="post" action="/apps" class="space-y-6"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="source_mode" value="<%= preset?'github':'github' %>">
<section class="grid gap-3 md:grid-cols-3"><button type="button" class="project-source" data-project-source="github"><div class="text-lg font-black">GitHub</div><div class="mt-2 text-xs text-slate-500">Import public/private repo dan deploy atomic.</div></button><button type="button" class="project-source" data-project-source="starter"><div class="text-lg font-black">Starter</div><div class="mt-2 text-xs text-slate-500">Express, worker atau static starter.</div></button><button type="button" class="project-source" data-project-source="existing"><div class="text-lg font-black">Existing</div><div class="mt-2 text-xs text-slate-500">Daftarkan source yang sudah ada di VPS.</div></button></section>

<section class="card p-5 sm:p-6" data-source-panel="github"><div class="flex items-center justify-between"><div><div class="metric-kicker">Step 1</div><h3 class="mt-1 font-bold">Select repository</h3></div><span data-repo-inspect-status class="text-xs text-gold-300"><%= preset?`${preset.framework} detected`:'' %></span></div>
<% if(connectionError){ %><div class="mt-4 badge-warn"><%= connectionError %></div><% } %>
<div class="mt-4 max-h-80 space-y-2 overflow-y-auto pr-1"><% if(!repos.length){ %><div class="rounded-xl border border-dashed border-white/10 p-5 text-sm text-slate-500">Belum ada repo dari koneksi GitHub. Kamu tetap bisa paste URL di bawah, atau <a class="text-gold-300" href="/integrations">hubungkan GitHub</a>.</div><% } repos.forEach(repo=>{ %><button type="button" class="repo-card <%= preset?.fullName===repo.full_name?'repo-card-active':'' %>" data-github-repo="https://github.com/<%= repo.full_name %>" data-default-branch="<%= repo.default_branch %>"><span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white/[.05] font-black">GH</span><span class="min-w-0 flex-1"><span class="block truncate font-semibold"><%= repo.full_name %></span><span class="mt-1 block truncate text-[11px] text-slate-600"><%= repo.private?'Private':'Public' %> · <%= repo.language||'Unknown' %> · <%= repo.default_branch %></span></span></button><% }) %></div>
<div class="mt-4 grid gap-4 sm:grid-cols-[1fr_.35fr]"><div><label class="label">Repository URL</label><input class="field" name="git_repo" value="<%= preset?.repo||'' %>" placeholder="https://github.com/org/project"></div><div><label class="label">Branch</label><input class="field" name="git_branch" value="<%= preset?.branch||'main' %>"></div></div></section>

<section class="card p-5 sm:p-6" data-source-panel="starter" hidden><div class="metric-kicker">Step 1</div><h3 class="mt-1 font-bold">Starter template</h3><div class="mt-4"><label class="label">Template</label><select class="field" name="template"><option value="existing">Existing / Git</option><option value="express">Express starter</option><option value="node-worker">Node worker</option><option value="static">Static site</option></select></div></section>
<section class="card p-5 sm:p-6" data-source-panel="existing" hidden><div class="metric-kicker">Step 1</div><h3 class="mt-1 font-bold">Existing source</h3><p class="mt-2 text-sm text-slate-500">Masukkan project metadata di langkah berikut. Folder tidak akan dihapus oleh HostPanel.</p></section>

<section class="card p-5 sm:p-6"><div class="metric-kicker">Step 2</div><h3 class="mt-1 font-bold">Configure project</h3><div class="mt-5 grid gap-4 md:grid-cols-2"><div><label class="label">Project name</label><input data-project-name class="field" name="name" value="<%= preset?.packageName||'' %>" placeholder="Nama Project " required></div><div><label class="label">Project slug</label><input data-project-slug class="field" name="slug" value="<%= preset?.packageName?String(preset.packageName).toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'').slice(0,40):'' %>" placeholder="nama-project " required></div><div><label class="label">Domain (optional)</label><input class="field" name="domain" placeholder="app.example.com"></div><div><label class="label">Internal port</label><input class="field" type="number" min="1024" max="65535" name="port" value="<%= nextPort %>" required></div><input data-project-dir type="hidden" name="working_dir" value="<%= preset?.packageName?`/nusantara-hostpanel/apps/${String(preset.packageName).toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'').slice(0,40)}`:'' %>"></div>
<label class="mt-5 flex items-center gap-3 rounded-xl border border-white/[.08] bg-white/[.03] p-4 text-sm"><input type="checkbox" name="auto_deploy" value="1" checked><span><b>Auto Deploy</b><span class="mt-1 block text-xs text-slate-500">Push ke branch production dapat memicu deployment lewat webhook GitHub.</span></span></label>
<label class="mt-3 flex items-center gap-3 rounded-xl border border-white/[.08] bg-white/[.03] p-4 text-sm"><input type="checkbox" name="preview_enabled" value="1" checked><span><b>Preview Environments</b><span class="mt-1 block text-xs text-slate-500">Branch/PR dapat dibuat sebagai runtime preview terpisah.</span></span></label>
</section>

<details class="card p-5 sm:p-6"><summary class="cursor-pointer font-bold">Advanced Settings</summary><div class="mt-5 grid gap-4 md:grid-cols-2"><div><label class="label">Node runtime</label><select class="field" name="node_runtime"><option value="system">System</option><option value="node22">Node 22 LTS</option><option value="node24">Node 24 LTS</option><option value="node20">Node 20 legacy</option></select></div><div><label class="label">Install command</label><select class="field" name="install_command"><option>npm ci</option><option>npm install</option><option>pnpm install --frozen-lockfile</option><option>yarn install --immutable</option></select></div><div><label class="label">Start mode</label><select class="field" name="start_mode"><option value="npm" selected>npm script</option><option value="node">Node entry</option><option value="command">Safe command</option></select></div><div><label class="label">npm start script</label><input class="field" name="npm_script" value="<%= preset?.npmScript||'start' %>"></div><div><label class="label">Entry file</label><input class="field" name="entry_file" value="<%= preset?.entryFile||'server.js' %>"></div><div><label class="label">Build script</label><input class="field" name="build_script" value="<%= preset?.buildScript||'' %>" placeholder="build"></div><div><label class="label">Health path</label><input class="field" name="health_path" value="<%= preset?.healthPath||'/' %>"></div><div><label class="label">Release retention</label><input class="field" name="release_keep" type="number" min="2" max="20" value="5"></div><div><label class="label">Memory limit MB</label><input class="field" name="memory_limit_mb" type="number" min="0" max="65536" value="0"></div><div><label class="label">CPU quota %</label><input class="field" name="cpu_quota_percent" type="number" min="0" max="800" value="0"></div><div><label class="label">Tasks max</label><input class="field" name="tasks_max" type="number" min="0" max="4096" value="0"></div><div><label class="label">Restart policy</label><select class="field" name="restart_policy"><option value="on-failure">On failure</option><option value="always">Always</option><option value="no">No restart</option></select></div><div class="md:col-span-2"><label class="label">Start command (only command mode)</label><input class="field" name="start_command" placeholder="node dist/server.js"></div><div class="md:col-span-2"><label class="label">Environment variables</label><textarea class="field min-h-32 font-mono text-xs" name="environment_text" placeholder="DATABASE_URL=...&#10;COOKIE_SECRET=..."></textarea></div><input type="hidden" name="preview_domain_suffix" value=""></div></details>
<button class="btn-primary w-full py-4 text-base" type="submit">Deploy Project</button>
</form>
<%- include('../partials/app-end') %>
