<%- include('../partials/app-start') %>
<section class="card p-5 sm:p-6">
  <div class="flex flex-col justify-between gap-4 xl:flex-row xl:items-start"><div><div class="metric-kicker">Create project</div><h2 class="mt-1 text-xl font-bold">Daftarkan aplikasi Node.js</h2><p class="mt-2 max-w-3xl text-sm text-slate-500">Runtime systemd di production; simulator aman di laptop. Repository GitHub public/private didukung; token private disimpan terenkripsi dan tidak pernah ditampilkan ulang.</p></div><span class="badge">Start · Stop · Restart · Health · Deploy · Logs</span></div>
  <form method="post" action="/apps" class="mt-6 grid gap-4 lg:grid-cols-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label class="label">Nama aplikasi</label><input class="field" name="name" placeholder="Nama Project " required></div><div><label class="label">Slug</label><input class="field" name="slug" placeholder="nama-project " required></div>
    <div><label class="label">Working directory</label><input class="field" name="working_dir" placeholder="/nusantara-hostpanel/apps/nama-project " required></div><div><label class="label">Port internal</label><input class="field" name="port" type="number" min="1024" max="65535" placeholder="4100" required></div>
    <div><label class="label">Start mode</label><select class="field" name="start_mode"><option value="node">Node entry file</option><option value="npm">npm script</option><option value="command">Command aman</option></select></div><div><label class="label">Restart policy</label><select class="field" name="restart_policy"><option value="on-failure">On failure</option><option value="always">Always</option><option value="no">Tidak otomatis</option></select></div>
    <div><label class="label">Project template</label><select class="field" name="template"><option value="existing">Existing source / Git</option><option value="express">Express starter</option><option value="node-worker">Node worker</option><option value="static">Static site</option></select></div><div><label class="label">Node runtime</label><select class="field" name="node_runtime"><option value="system">System (default)</option><option value="node20">Node 20</option><option value="node22">Node 22</option><option value="node24">Node 24</option></select><p class="mt-1 text-xs text-slate-600">Runtime tambahan dipasang root via scripts/install-node-runtime.sh.</p></div>
    <div><label class="label">Entry file</label><input class="field" name="entry_file" value="server.js"></div><div><label class="label">npm start script</label><input class="field" name="npm_script" value="start"></div>
    <div class="lg:col-span-2"><label class="label">Start command</label><input class="field" name="start_command" placeholder="node dist/server.js --production"><p class="mt-1 text-xs text-slate-600">Tidak ada shell operator; helper hanya menerima runtime yang diizinkan.</p></div>
    <div><label class="label">GitHub repository (opsional)</label><input class="field" name="git_repo" placeholder="https://github.com/org/project"></div><div><label class="label">Branch</label><input class="field" name="git_branch" value="main"></div>
    <div><label class="label">Private Git token (opsional)</label><input class="field" type="password" name="git_token" autocomplete="new-password" placeholder="github_pat_…"><p class="mt-1 text-xs text-slate-600">Encrypted at rest; hanya digunakan saat clone/fetch.</p></div><div><label class="label">Install command</label><input class="field" name="install_command" value="npm ci" placeholder="npm ci"></div>
    <div><label class="label">Build npm script</label><input class="field" name="build_script" placeholder="build"></div><div><label class="label">Health path</label><input class="field" name="health_path" value="/" placeholder="/healthz"></div>
    <div><label class="label">Release retention</label><input class="field" name="release_keep" type="number" min="2" max="20" value="5"></div><div><label class="label">Preview domain suffix</label><input class="field" name="preview_domain_suffix" placeholder="preview.example.com"></div>
    <label class="flex items-center gap-2 text-sm text-slate-400"><input type="checkbox" name="auto_deploy" value="1"> Auto-deploy GitHub webhook</label><label class="flex items-center gap-2 text-sm text-slate-400"><input type="checkbox" name="preview_enabled" value="1"> Enable PR/branch preview environments</label>
    <div><label class="label">Memory limit (MB)</label><input class="field" name="memory_limit_mb" type="number" min="0" max="65536" value="0"><p class="mt-1 text-xs text-slate-600">0 = tanpa limit tambahan.</p></div><div><label class="label">CPU quota (%)</label><input class="field" name="cpu_quota_percent" type="number" min="0" max="800" value="0"><p class="mt-1 text-xs text-slate-600">100 = satu core penuh; 0 = default systemd.</p></div>
    <div><label class="label">Tasks max</label><input class="field" name="tasks_max" type="number" min="0" max="4096" value="0"><p class="mt-1 text-xs text-slate-600">Batasi jumlah task/thread per app.</p></div><div class="flex items-end"><div class="rounded-xl border border-emerald-400/15 bg-emerald-400/5 p-3 text-xs text-slate-500">Resource guard ditulis ke unit systemd sebagai MemoryMax, CPUQuota, dan TasksMax.</div></div>
    <div class="lg:col-span-2"><label class="label">Environment variables</label><textarea class="field min-h-36 font-mono text-xs" name="environment_text" placeholder="DATABASE_URL=mysql://...&#10;COOKIE_SECRET=..."></textarea><p class="mt-1 text-xs text-slate-600">Disimpan di <code>/etc/hostpanel/apps/&lt;slug&gt;.env</code>; nilai existing tidak pernah ditampilkan ulang.</p></div>
    <div class="lg:col-span-2"><label class="label">Domain opsional</label><input class="field" name="domain" placeholder="news.example.com"></div><div class="lg:col-span-2"><button class="btn-primary w-full" type="submit">Create project</button></div>
  </form>
</section>

<section class="mt-6"><div class="mb-4 flex items-end justify-between"><div><div class="metric-kicker">Projects</div><h2 class="mt-1 font-bold">Aplikasi terdaftar</h2></div><a class="text-xs font-semibold text-gold-300" href="/deployments">Deployment history →</a></div><div class="grid gap-4 xl:grid-cols-2">
<% if(!apps.length){ %><div class="card p-7 text-sm text-slate-500 xl:col-span-2">Belum ada aplikasi.</div><% } %>
<% apps.forEach(app=>{const active=app.runtime?.activeState==='active';const failed=app.runtime?.activeState==='failed';const healthy=Boolean(app.health?.ok);%>
<article class="card overflow-hidden"><div class="p-5"><div class="flex items-start justify-between gap-4"><div class="min-w-0"><div class="flex flex-wrap items-center gap-2"><h3 class="truncate text-lg font-bold"><a class="hover:text-gold-300" href="/apps/<%= app.id %>"><%= app.name %></a></h3><span class="<%= active?'badge-ok':failed?'badge-bad':'badge' %>"><%= active?'RUNNING':failed?'FAILED':String(app.runtime?.activeState||'UNKNOWN').toUpperCase() %></span><span class="<%= healthy?'badge-ok':'badge-warn' %>"><%= healthy?'HEALTHY':'UNHEALTHY' %></span></div><p class="mt-1 truncate text-xs text-slate-600"><%= app.slug %> · <%= app.working_dir %></p></div><span class="badge"><%= (app.start_mode||'node').toUpperCase() %></span></div>
<div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4"><div class="rounded-xl bg-white/[0.035] p-3"><div class="metric-kicker">Port</div><div class="mt-1 text-sm font-bold"><%= app.port %></div></div><div class="rounded-xl bg-white/[0.035] p-3"><div class="metric-kicker">PID</div><div class="mt-1 text-sm font-bold"><%= app.runtime?.pid||'-' %></div></div><div class="rounded-xl bg-white/[0.035] p-3"><div class="metric-kicker">Health</div><div class="mt-1 text-sm font-bold"><%= app.health?.statusCode||'-' %></div></div><div class="rounded-xl bg-white/[0.035] p-3"><div class="metric-kicker">Commit</div><div class="mt-1 truncate text-sm font-bold"><%= app.last_deployed_commit?app.last_deployed_commit.slice(0,8):'-' %></div></div></div>
<div class="mt-4 flex flex-wrap gap-2"><% if(!active){ %><form method="post" action="/apps/<%= app.id %>/action/start"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-primary" type="submit">Start</button></form><% } %><% if(active){ %><form method="post" action="/apps/<%= app.id %>/action/stop"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-secondary" type="submit">Stop</button></form><% } %><form method="post" action="/apps/<%= app.id %>/action/restart"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-secondary" type="submit">Restart</button></form><% if(app.git_repo){ %><form method="post" action="/apps/<%= app.id %>/deploy"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-primary" data-confirm="Deploy branch <%= app.git_branch || 'main' %> dan restart aplikasi?" type="submit">Deploy</button></form><% } %><a class="btn-secondary" href="/apps/<%= app.id %>">Overview</a><a class="btn-secondary" href="/apps/<%= app.id %>/logs">Logs</a></div>
<% if(app.domain||app.git_repo){ %><div class="mt-4 flex flex-wrap gap-2 border-t border-white/[0.06] pt-4 text-xs"><% if(app.domain){ %><span class="badge"><%= app.ssl_enabled?'HTTPS':'HTTP' %> · <%= app.domain %></span><% } %><% if(app.git_repo){ %><span class="badge"><%= app.git_repo.replace('https://github.com/','') %> @ <%= app.git_branch||'main' %></span><% } %></div><% } %>
<% if(app.memory_limit_mb||app.cpu_quota_percent||app.tasks_max){ %><div class="mt-3 flex flex-wrap gap-2 text-xs"><% if(app.memory_limit_mb){ %><span class="badge">RAM ≤ <%= app.memory_limit_mb %> MB</span><% } %><% if(app.cpu_quota_percent){ %><span class="badge">CPU ≤ <%= app.cpu_quota_percent %>%</span><% } %><% if(app.tasks_max){ %><span class="badge">Tasks ≤ <%= app.tasks_max %></span><% } %></div><% } %>
</div><details class="border-t border-white/[0.07] bg-black/10 px-5 py-4"><summary class="cursor-pointer text-sm font-semibold text-slate-300">Project settings</summary><form method="post" action="/apps/<%= app.id %>/update" class="mt-4 grid gap-4 lg:grid-cols-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div><label class="label">Nama</label><input class="field" name="name" value="<%= app.name %>" required></div><div><label class="label">Slug</label><input class="field" value="<%= app.slug %>" disabled></div><div><label class="label">Working directory</label><input class="field" name="working_dir" value="<%= app.working_dir %>" required></div><div><label class="label">Port</label><input class="field" name="port" type="number" min="1024" max="65535" value="<%= app.port %>" required></div><div><label class="label">Start mode</label><select class="field" name="start_mode"><% ['node','npm','command'].forEach(m=>{ %><option value="<%= m %>" <%= (app.start_mode||'node')===m?'selected':'' %>><%= m %></option><% }) %></select></div><div><label class="label">Restart policy</label><select class="field" name="restart_policy"><% ['on-failure','always','no'].forEach(m=>{ %><option value="<%= m %>" <%= (app.restart_policy||'on-failure')===m?'selected':'' %>><%= m %></option><% }) %></select></div><div><label class="label">Project template</label><select class="field" name="template"><% ['existing','express','node-worker','static'].forEach(m=>{ %><option value="<%= m %>" <%= (app.template||'existing')===m?'selected':'' %>><%= m %></option><% }) %></select></div><div><label class="label">Node runtime</label><select class="field" name="node_runtime"><% ['system','node20','node22','node24'].forEach(m=>{ %><option value="<%= m %>" <%= (app.node_runtime||'system')===m?'selected':'' %>><%= m %></option><% }) %></select></div><div><label class="label">Entry file</label><input class="field" name="entry_file" value="<%= app.entry_file||'server.js' %>"></div><div><label class="label">npm start script</label><input class="field" name="npm_script" value="<%= app.npm_script||'start' %>"></div><div class="lg:col-span-2"><label class="label">Start command</label><input class="field" name="start_command" value="<%= app.start_command||'' %>"></div><div><label class="label">GitHub repository</label><input class="field" name="git_repo" value="<%= app.git_repo||'' %>"></div><div><label class="label">Branch</label><input class="field" name="git_branch" value="<%= app.git_branch||'main' %>"></div><div><label class="label">Private Git token</label><input class="field" type="password" name="git_token" autocomplete="new-password" placeholder="Kosong = pertahankan credential"><label class="mt-2 flex items-center gap-2 text-xs text-slate-400"><input type="checkbox" name="clear_git_token" value="1"> Hapus credential Git tersimpan</label></div><div><label class="label">Install command</label><input class="field" name="install_command" value="<%= app.install_command||'npm ci' %>"></div><div><label class="label">Build npm script</label><input class="field" name="build_script" value="<%= app.build_script||'' %>"></div><div><label class="label">Health path</label><input class="field" name="health_path" value="<%= app.health_path||'/' %>"></div><div><label class="label">Release retention</label><input class="field" name="release_keep" type="number" min="2" max="20" value="<%= app.release_keep||5 %>"></div><div><label class="label">Preview domain suffix</label><input class="field" name="preview_domain_suffix" value="<%= app.preview_domain_suffix||'' %>" placeholder="preview.example.com"></div><label class="flex items-center gap-2 text-sm text-slate-400"><input type="checkbox" name="auto_deploy" value="1" <%= app.auto_deploy?'checked':'' %>> Auto-deploy GitHub webhook</label><label class="flex items-center gap-2 text-sm text-slate-400"><input type="checkbox" name="preview_enabled" value="1" <%= app.preview_enabled?'checked':'' %>> Enable PR/branch preview environments</label><div><label class="label">Memory limit (MB)</label><input class="field" name="memory_limit_mb" type="number" min="0" max="65536" value="<%= app.memory_limit_mb||0 %>"></div><div><label class="label">CPU quota (%)</label><input class="field" name="cpu_quota_percent" type="number" min="0" max="800" value="<%= app.cpu_quota_percent||0 %>"></div><div><label class="label">Tasks max</label><input class="field" name="tasks_max" type="number" min="0" max="4096" value="<%= app.tasks_max||0 %>"></div><div></div><div class="lg:col-span-2"><label class="label">Environment</label><textarea class="field min-h-32 font-mono text-xs" name="environment_text" placeholder="Isi hanya bila ingin mengganti env."></textarea><label class="mt-2 flex items-center gap-2 text-xs text-slate-400"><input type="checkbox" name="replace_environment" value="1"> Ganti environment file</label></div><div class="lg:col-span-2"><button class="btn-primary" type="submit">Save & Restart</button></div></form><form class="mt-3" method="post" action="/apps/<%= app.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-danger" data-confirm="Hapus service aplikasi? Source tidak dihapus." type="submit">Hapus aplikasi</button></form></details></article>
<% }) %></div></section>
<%- include('../partials/app-end') %>
