<%- include('../partials/app-start') %>
<div class="grid gap-4 sm:grid-cols-2"><section class="metric"><div class="metric-kicker">Memory trend</div><div class="mt-4 flex h-20 items-end gap-1"><% memory.forEach(x=>{ %><span class="min-w-1 flex-1 rounded-t bg-gold-400/60" style="height:<%= Math.max(2,Math.min(100,Number(x.value))) %>%" title="<%= x.value %>%"></span><% }) %></div></section><section class="metric"><div class="metric-kicker">Disk trend</div><div class="mt-4 flex h-20 items-end gap-1"><% disk.forEach(x=>{ %><span class="min-w-1 flex-1 rounded-t bg-cyan-400/50" style="height:<%= Math.max(2,Math.min(100,Number(x.value))) %>%" title="<%= x.value %>%"></span><% }) %></div></section></div>
<div class="mt-6 grid gap-6 xl:grid-cols-[.85fr_1.15fr]"><section class="card p-5 sm:p-6"><div class="metric-kicker">Policy</div><h2 class="mt-1 text-xl font-black">Alert Rules</h2><form class="mt-5 grid gap-3" method="post" action="/alerts"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="field" name="name" placeholder="Disk almost full" required><div class="grid grid-cols-2 gap-3"><select class="field" name="metric"><option value="memory_percent">Memory %</option><option value="disk_percent">Disk %</option><option value="load_per_cpu">Load / CPU</option><option value="app_unhealthy">App unhealthy</option><option value="ssl_days">SSL days remaining</option><option value="backup_failed">Backup failed</option><option value="job_failed">Job failed</option></select><select class="field" name="operator"><option value="gte">≥</option><option value="lte">≤</option><option value="eq">=</option></select></div><div class="grid grid-cols-2 gap-3"><input class="field" type="number" step="0.1" name="threshold" value="90"><select class="field" name="severity"><option>warn</option><option>critical</option><option>info</option></select></div><div class="grid grid-cols-2 gap-3"><input class="field" type="number" min="0" name="duration_min" value="5" placeholder="Duration min"><input class="field" type="number" min="1" name="cooldown_min" value="60" placeholder="Cooldown min"></div><button class="btn-primary">Add rule</button></form><div class="mt-6 space-y-2"><% rules.forEach(r=>{ %><div class="flex items-center gap-3 rounded-xl border border-white/[.08] p-3"><div class="min-w-0 flex-1"><div class="font-semibold"><%= r.name %></div><div class="text-xs text-slate-600"><%= r.metric %> <%= r.operator %> <%= r.threshold %> · <%= r.severity %></div></div><form method="post" action="/alerts/<%= r.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-danger !px-3 !py-2 text-xs">Delete</button></form></div><% }) %></div></section><section><div class="metric-kicker">Incident stream</div><h2 class="mt-1 font-bold">Recent events</h2><div class="mt-4 space-y-3"><% if(!events.length){ %><div class="card p-6 text-sm text-slate-500">Belum ada alert event.</div><% } events.forEach(e=>{ %><div class="card p-4"><div class="flex items-center justify-between gap-3"><div class="font-semibold"><%= e.rule_name||e.fingerprint %></div><span class="<%= e.status==='open'?'badge-bad':'badge-ok' %>"><%= e.status %></span></div><div class="mt-2 text-sm text-slate-400"><%= e.message %></div><div class="mt-2 text-xs text-slate-600"><%= e.opened_at %><% if(e.resolved_at){ %> → <%= e.resolved_at %><% } %></div></div><% }) %></div></section></div>
<%- include('../partials/app-end') %>
