<%- include('../partials/app-start') %>
<section class="mx-auto max-w-2xl card p-6 sm:p-8">
  <div class="rounded-xl border border-gold-400/20 bg-gold-400/[0.06] p-4 text-sm text-slate-300">Halaman ini menggunakan <strong>Cache-Control: no-store</strong>. Password plaintext hanya diberikan pada respons ini.</div>
  <h1 class="mt-6 text-2xl font-bold"><%= heading %></h1>
  <p class="mt-2 text-sm text-slate-500"><%= description %></p>
  <div class="mt-6 space-y-3 rounded-2xl border border-white/10 bg-black/20 p-5">
    <% if (host) { %><div><div class="text-xs text-slate-500">Host / URL</div><div class="mt-1 break-all font-mono text-sm"><%= host %></div></div><% } %>
    <div><div class="text-xs text-slate-500">Username</div><div class="mt-1 font-mono text-sm"><%= username %></div></div>
    <div><div class="text-xs text-slate-500">Password baru</div><div class="mt-1 break-all rounded-xl border border-white/10 bg-black/30 p-3 font-mono text-sm"><%= password %></div></div>
  </div>
  <div class="mt-6 flex gap-3"><a class="btn-primary" href="<%= backUrl %>">Saya sudah menyimpan</a></div>
</section>
<%- include('../partials/app-end') %>
