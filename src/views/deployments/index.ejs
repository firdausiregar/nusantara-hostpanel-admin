<%- include('../partials/app-start') %>
<div class="mb-6"><div class="metric-kicker">Release history</div><h2 class="mt-1 text-2xl font-black">Deployments</h2><p class="mt-2 text-sm text-slate-500">Riwayat deploy Git per project. Deployment gagal dicatat dan helper mencoba mengembalikan commit sebelumnya.</p></div>
<section class="card p-5 sm:p-6"><div class="space-y-0"><% if(!deployments.length){ %><p class="text-sm text-slate-600">Belum ada deployment.</p><% } %><% deployments.forEach((d,i)=>{ %><div class="flex gap-4 <%= i<deployments.length-1?'border-b border-white/[0.06]':'' %> py-4"><span class="timeline-dot <%= d.status==='success'?'!bg-emerald-400':d.status==='failed'?'!bg-red-400':'!bg-amber-400' %>"></span><div class="min-w-0 flex-1"><div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-center"><div><span class="font-semibold"><%= d.app_name %></span><span class="ml-2 text-xs text-slate-600"><%= d.app_slug %></span></div><span class="<%= d.status==='success'?'badge-ok':d.status==='failed'?'badge-bad':'badge-warn' %>"><%= d.status %></span></div><div class="mt-2 flex flex-wrap gap-2 text-xs text-slate-500"><span><%= d.branch||'-' %></span><span>·</span><span class="font-mono"><%= d.commit_sha?d.commit_sha.slice(0,12):'-' %></span><span>·</span><span><%= d.started_at %></span></div><% if(d.message){ %><p class="mt-2 text-xs text-slate-500"><%= d.message %></p><% } %></div></div><% }) %></div></section>
<%- include('../partials/app-end') %>
