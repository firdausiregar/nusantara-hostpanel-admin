<%- include('../partials/head') %><div class="flex min-h-screen items-center justify-center p-5"><form method="post" action="/reset-password/<%= encodeURIComponent(token) %>" class="card w-full max-w-md p-7 sm:p-9"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="metric-kicker">Account recovery</div><h1 class="mt-2 text-2xl font-black">Create a new password</h1><p class="mt-2 text-sm text-slate-500"><%= email %></p><div class="mt-6"><label class="label">New password</label><input class="field" type="password" name="password" autocomplete="new-password" required></div><% if(flash){ %><div class="mt-4 badge-bad"><%= flash.message %></div><% } %><button class="btn-primary mt-4 w-full">Change password & revoke sessions</button></form></div><%- include('../partials/footer') %>
