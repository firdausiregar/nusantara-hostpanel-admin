<%- include('../partials/head') %>
<div class="flex min-h-screen items-center justify-center p-6">
  <form method="post" action="/setup" class="card w-full max-w-lg p-8">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="mb-7 flex h-12 w-12 items-center justify-center rounded-xl bg-gold-400 font-black text-ink-950">H</div>
    <h1 class="text-2xl font-bold">Buat administrator pertama</h1>
    <p class="mt-2 text-sm text-slate-500">Setup ini otomatis terkunci setelah akun pertama dibuat.</p>
    <div class="mt-6"><label class="label">Email admin</label><input class="field" type="email" name="email" required></div>
    <div class="mt-4"><label class="label">Password</label><input class="field" type="password" name="password" minlength="<%= minPasswordChars %>" required><p class="mt-1.5 text-xs text-slate-600">Minimal <%= minPasswordChars %> karakter dan maksimal <%= maxPasswordBytes %> byte.</p></div>
    <% if (flash) { %><div class="mt-4 rounded-xl border border-red-400/20 bg-red-500/10 px-4 py-3 text-sm text-red-200"><%= flash.message %></div><% } %>
    <button class="btn-primary mt-6 w-full" type="submit">Aktifkan panel</button>
  </form>
</div>
<%- include('../partials/footer') %>
