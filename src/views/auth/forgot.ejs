<%- include('../partials/head') %><div class="flex min-h-screen items-center justify-center p-5"><form method="post" action="/forgot-password" class="card w-full max-w-md p-7 sm:p-9"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="metric-kicker">Account recovery</div><h1 class="mt-2 text-2xl font-black">Reset password</h1><p class="mt-2 text-sm text-slate-500">Masukkan email akun. Bila akun tersedia dan SMTP aktif, link reset 30 menit akan dikirim.</p><% if(sent){ %><div class="mt-5 rounded-xl border border-emerald-400/20 bg-emerald-400/10 p-4 text-sm text-emerald-200">Jika akun tersebut tersedia, instruksi reset sudah diproses.</div><% } %><div class="mt-6"><label class="label">Email</label><input class="field" type="email" name="email" autocomplete="email" required></div><button class="btn-primary mt-4 w-full">Send reset link</button><a class="btn-secondary mt-3 w-full" href="/login">Back to login</a></form></div><%- include('../partials/footer') %>
