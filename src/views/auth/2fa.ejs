<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · <%= panelName %></title><link rel="stylesheet" href="/css/app.css?v=<%= release %>"></head><body class="min-h-screen"><main class="mx-auto flex min-h-screen max-w-md items-center px-5 py-10"><section class="card w-full p-7"><div class="metric-kicker">Security checkpoint</div><h1 class="mt-2 text-2xl font-black">Verifikasi dua faktor</h1><p class="mt-2 text-sm leading-6 text-slate-500">Masukkan kode 6 digit dari aplikasi authenticator atau salah satu recovery code.</p><%- include('../partials/flash') %><form class="mt-6 space-y-4" method="post" action="/login/2fa"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div><label class="label">Kode</label><input class="field font-mono tracking-[.25em]" name="code" inputmode="numeric" autocomplete="one-time-code" required autofocus></div><button class="btn-primary w-full" type="submit">Verifikasi & masuk</button></form><a class="mt-4 block text-center text-xs text-slate-500 hover:text-white" href="/login">Kembali ke login</a></section></main></body></html>
