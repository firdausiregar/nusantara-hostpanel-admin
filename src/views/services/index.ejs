<%- include('../partials/app-start') %>

<% if (typeof servicesError !== 'undefined' && servicesError) { %>
  <div class="mb-5 rounded-xl border border-red-400/20 bg-red-500/10 p-4 text-sm text-red-200">
    Privileged helper: <%= servicesError %>
  </div>
<% } %>

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <% (Array.isArray(services) ? services : []).forEach((service) => { %>
    <div class="card p-5">
      <div class="flex items-center justify-between gap-3">
        <div class="font-bold"><%= service.name %></div>
        <span class="badge">
          <span class="mr-2 h-2 w-2 rounded-full <%= service.active === true ? 'bg-emerald-400' : service.active === false ? 'bg-red-400' : 'bg-slate-500' %>"></span>
          <%= service.active === true ? 'active' : service.active === false ? 'inactive' : 'unknown' %>
        </span>
      </div>
      <div class="mt-5 flex flex-wrap gap-2">
        <form method="post" action="/services/<%= encodeURIComponent(service.name) %>/restart">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn-secondary" type="submit">Restart</button>
        </form>
        <% if (service.name === 'nginx' || service.name === 'bind9') { %>
          <form method="post" action="/services/<%= encodeURIComponent(service.name) %>/reload">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn-secondary" type="submit">Reload</button>
          </form>
        <% } %>
      </div>
    </div>
  <% }) %>
</div>

<div class="mt-6 card p-6">
  <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
    <div>
      <h2 class="font-bold">phpMyAdmin</h2>
      <p class="mt-1 text-sm text-slate-500">Nginx + PHP-FPM dengan HTTP Basic Auth sebagai lapisan tambahan.</p>
    </div>
    <% if (phpMyAdminUrl) { %>
      <a class="btn-primary" href="<%= phpMyAdminUrl %>" target="_blank" rel="noopener noreferrer">Buka phpMyAdmin ↗</a>
    <% } else { %>
      <span class="badge">PHPMYADMIN_URL belum diset</span>
    <% } %>
  </div>
</div>

<%- include('../partials/app-end') %>
