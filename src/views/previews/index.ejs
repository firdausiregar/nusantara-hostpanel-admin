<%- include('../partials/app-start') %>
<div class="grid gap-6 xl:grid-cols-[.8fr_1.2fr]"><section class="card p-5 sm:p-6"><div class="metric-kicker">Branch runtime</div><h2 class="mt-1 text-xl font-black">Create Preview</h2><p class="mt-2 text-sm text-slate-500">Preview berjalan sebagai service systemd terisolasi dengan port sendiri dan TTL cleanup. Isi environment <b>Preview</b> di project sebelum memakai secret.</p><form class="mt-5 space-y-4" method="post" action="/previews"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div><label class="label">Project</label><select class="field" name="app_id" required><% apps.filter(a=>a.git_repo&&a.preview_enabled).forEach(a=>{ %><option value="<%= a.id %>"><%= a.name %></option><% }) %></select></div><div><label class="label">Git branch</label><input class="field" name="branch" placeholder="feature/new-home" required></div><div><label class="label">TTL days</label><input class="field" type="number" min="1" max="30" name="ttl_days" value="7"></div><button class="btn-primary w-full">Build Preview</button></form></section><section><div class="mb-4"><div class="metric-kicker">Environments</div><h2 class="mt-1 font-bold">Active & recent previews</h2></div><div class="grid gap-3"><% if(!items.length){ %><div class="card p-6 text-sm text-slate-500">Belum ada preview deployment.</div><% } items.forEach(p=>{ %><article class="card p-5"><div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"><div class="min-w-0"><div class="flex flex-wrap items-center gap-2"><h3 class="font-bold"><%= p.app_name %> / <%= p.branch %></h3><span class="<%= p.status==='active'?'badge-ok':p.status==='failed'?'badge-bad':'badge-warn' %>"><%= p.status.toUpperCase() %></span></div><div class="mt-2 text-xs text-slate-600">Port <%= p.port %> · expires <%= p.expires_at||'manual' %></div><% if(p.hostname){ %><a target="_blank" rel="noreferrer" class="mt-2 block truncate text-sm text-gold-300" href="https://<%= p.hostname %>"><%= p.hostname %> ↗</a><% } %></div><div class="flex gap-2"><a class="btn-secondary !px-3 !py-2 text-xs" href="/previews/<%= p.id %>/logs">Logs</a><% if(p.status!=='stopped'){ %><form method="post" action="/previews/<%= p.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-danger !px-3 !py-2 text-xs" data-confirm="Stop dan hapus runtime preview ini?">Stop</button></form><% } %></div></div></article><% }) %></div></section></div>
<%- include('../partials/app-end') %>
