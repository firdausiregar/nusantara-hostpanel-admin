<%- include('../partials/app-start') %>
<div class="mb-6"><div class="metric-kicker">Observability</div><h2 class="mt-1 text-2xl font-black">Server health</h2><p class="mt-2 text-sm text-slate-500">Metrik read-only dari host. Tidak ada agent eksternal.</p></div>
<% if(error){ %><div class="card border-red-400/20 p-4 text-sm text-red-200"><%= error %></div><% } %>
<% if(metrics){const memPct=metrics.memory?.total?Math.round(metrics.memory.used/metrics.memory.total*100):0;%><div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4"><div class="metric"><div class="metric-kicker">Memory</div><div class="metric-value"><%= memPct %>%</div><progress class="mt-3 h-1.5 w-full" max="100" value="<%= memPct %>"></progress><div class="mt-2 text-xs text-slate-600"><%= formatBytes(metrics.memory.used) %> used</div></div><div class="metric"><div class="metric-kicker">Disk</div><div class="metric-value"><%= metrics.disk?.percent||0 %>%</div><progress class="mt-3 h-1.5 w-full" max="100" value="<%= metrics.disk?.percent||0 %>"></progress><div class="mt-2 text-xs text-slate-600"><%= formatBytes(metrics.disk?.free) %> free</div></div><div class="metric"><div class="metric-kicker">Load 1/5/15</div><div class="mt-3 text-xl font-black"><%= (metrics.loadavg||[]).map(x=>Number(x).toFixed(2)).join(' / ') %></div><div class="mt-2 text-xs text-slate-600"><%= metrics.cpuCount %> CPU threads</div></div><div class="metric"><div class="metric-kicker">Uptime</div><div class="mt-3 text-xl font-black"><%= formatUptime(metrics.uptimeSeconds) %></div><div class="mt-2 text-xs text-slate-600"><%= metrics.hostname %></div></div></div><% } %>
<section class="card mt-6 p-5 sm:p-6"><h3 class="font-bold">Platform services</h3><div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4"><% (services||[]).forEach(s=>{ %><div class="rounded-xl border border-white/[0.07] bg-black/15 p-4"><div class="flex items-center justify-between"><span class="font-semibold"><%= s.name %></span><span class="<%= s.active?'badge-ok':'badge-bad' %>"><%= s.active?'active':'inactive' %></span></div></div><% }) %></div></section>
<%- include('../partials/app-end') %>
