<%- include('../partials/app-start') %><div class="grid gap-6 lg:grid-cols-[.8fr_1.2fr]"><section class="metric"><div class="metric-kicker">Installed</div><div class="metric-value">v<%= current %></div><div class="mt-3"><span class="badge-ok">Running</span></div></section><section class="card p-6"><div class="flex items-start justify-between gap-4"><div><div class="metric-kicker">GitHub release channel</div><h2 class="mt-1 text-xl font-black"><%= latest?.tag||'Not published yet' %></h2></div><% if(hasUpdate){ %><span class="badge-warn">Update available</span><% } %></div><% if(error){ %><div class="mt-4 badge-warn"><%= error %></div><% } %><% if(latest){ %><p class="mt-3 text-sm text-slate-500">Published <%= latest.publishedAt %></p><a class="btn-secondary mt-4" target="_blank" rel="noreferrer" href="<%= latest.url %>">Open release</a><% } %><div class="mt-6 rounded-xl border border-white/[.08] bg-black/20 p-4 text-xs text-slate-400"><b class="text-slate-200">Safe update flow:</b> backup → git pull / extract release → <code>sudo -E bash scripts/install.sh</code> → health check. HostPanel tidak melakukan blind self-update sebagai root dari browser.</div></section></div><%- include('../partials/app-end') %>
