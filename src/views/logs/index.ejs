<%- include('../partials/app-start') %><div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><div class="metric-kicker">Observability</div><h2 class="mt-1 text-2xl font-black">Log Center</h2><p class="mt-2 text-sm text-slate-500">Tail journal aplikasi dan layanan tanpa memberikan shell terminal ke browser.</p></div><form method="get" class="flex gap-2"><select class="field" name="source"><option value="hostpanel" <%= source==='hostpanel'?'selected':'' %>>HostPanel</option><% if(user?.role==='admin'){ %><option value="nginx" <%= source==='nginx'?'selected':'' %>>Nginx</option><option value="bind9" <%= source==='bind9'?'selected':'' %>>BIND9</option><option value="mariadb" <%= source==='mariadb'?'selected':'' %>>MariaDB</option><option value="php-fpm" <%= source==='php-fpm'?'selected':'' %>>PHP-FPM</option><% } %><% apps.forEach(a=>{ %><option value="app:<%= a.slug %>" <%= source===`app:${a.slug}`?'selected':'' %>><%= a.name %></option><% }) %></select><button class="btn-secondary">Load</button></form></div><section class="card mt-6 p-4"><div class="mb-3 flex justify-between text-xs text-slate-500"><span><%= source %></span><span>refresh 5s</span></div><pre id="log-output" data-log-source="<%= source %>" data-csrf="<%= csrfToken %>" class="max-h-[65vh] overflow-auto whitespace-pre-wrap break-words rounded-xl bg-black/35 p-4 font-mono text-xs leading-6 text-slate-300"><%= error||content||'(empty)' %></pre></section><%- include('../partials/app-end') %>
