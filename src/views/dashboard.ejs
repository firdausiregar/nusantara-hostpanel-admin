<%- include('partials/app-start') %>
<section class="relative overflow-hidden rounded-3xl border border-white/[0.08] bg-gradient-to-br from-white/[0.06] to-white/[0.015] p-6 sm:p-8">
  <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-gold-400/[0.06] blur-3xl"></div>
  <div class="relative flex flex-col justify-between gap-6 xl:flex-row xl:items-end"><div><div class="metric-kicker"><%= permissions?.isPlatformAdmin ? 'Nusantara Platform' : 'Workspace Console' %></div><h2 class="mt-2 max-w-3xl text-2xl font-black tracking-tight text-white sm:text-3xl"><%= permissions?.isPlatformAdmin ? 'Deploy, route, secure, dan operasikan aplikasi Node.js dari satu control plane.' : `Kelola project, deployment, domain, dan layanan workspace ${workspace?.name||''}.` %></h2><p class="mt-3 max-w-2xl text-sm leading-6 text-slate-400"><%= permissions?.isPlatformAdmin ? "Systemd-first, Nginx ingress, DNS BIND9, MariaDB, Let's Encrypt, audit log, backup, dan monitoring tanpa memberikan shell bebas ke panel web." : 'Akses yang tampil disesuaikan dengan role workspace. Operasi server-level hanya tersedia untuk administrator platform.' %></p></div><div class="flex flex-wrap gap-2"><a class="btn-primary" href="/apps"><%= permissions?.canDevelop && !permissions?.suspended ? '+ Project' : 'View Projects' %></a><% if(permissions?.isPlatformAdmin){ %><a class="btn-secondary" href="/monitoring">Server health</a><% } else { %><a class="btn-secondary" href="/domains">Domains</a><% } %></div></div>
</section>

<div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
  <% [['Projects',counts.apps,'Node services'],['Domains',counts.domains,'Nginx routes'],['DNS Zones',counts.zones,configSummary.dnsPublic?'Authoritative public':'Local/private'],['HTTPS',counts.ssl,'App domains'],['Deployments',counts.deployments,'Successful']].forEach(([label,value,sub])=>{ %><div class="metric"><div class="metric-kicker"><%= label %></div><div class="metric-value"><%= value %></div><div class="mt-1 text-xs text-slate-600"><%= sub %></div></div><% }) %>
</div>

<% if (permissions?.isPlatformAdmin && metrics) { const memPct=metrics.memory?.total?Math.round((metrics.memory.used/metrics.memory.total)*100):0; %>
<div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
  <div class="card p-5"><div class="metric-kicker">Memory</div><div class="mt-2 text-xl font-bold"><%= memPct %>%</div><progress class="mt-3 h-1.5 w-full overflow-hidden rounded-full" max="100" value="<%= Math.min(100,memPct) %>"></progress><div class="mt-2 text-xs text-slate-600"><%= formatBytes(metrics.memory?.used) %> / <%= formatBytes(metrics.memory?.total) %></div></div>
  <div class="card p-5"><div class="metric-kicker">Disk /</div><div class="mt-2 text-xl font-bold"><%= metrics.disk?.percent || 0 %>%</div><progress class="mt-3 h-1.5 w-full overflow-hidden rounded-full" max="100" value="<%= Math.min(100,metrics.disk?.percent||0) %>"></progress><div class="mt-2 text-xs text-slate-600"><%= formatBytes(metrics.disk?.used) %> / <%= formatBytes(metrics.disk?.total) %></div></div>
  <div class="card p-5"><div class="metric-kicker">Load average</div><div class="mt-2 text-xl font-bold"><%= (metrics.loadavg||[]).slice(0,3).map(x=>Number(x).toFixed(2)).join(' · ') || '-' %></div><div class="mt-2 text-xs text-slate-600"><%= metrics.cpuCount || '-' %> CPU threads</div></div>
  <div class="card p-5"><div class="metric-kicker">Uptime</div><div class="mt-2 text-xl font-bold"><%= formatUptime(metrics.uptimeSeconds) %></div><div class="mt-2 text-xs text-slate-600"><%= metrics.hostname || 'server' %></div></div>
</div><% } %>

<div class="mt-6 grid gap-6 <%= permissions?.isPlatformAdmin ? 'xl:grid-cols-[1.05fr_.95fr]' : '' %>">
  <% if(permissions?.isPlatformAdmin){ %><section class="card p-5 sm:p-6"><div class="flex items-center justify-between"><div><h2 class="font-bold">Service health</h2><p class="mt-1 text-sm text-slate-500">Status platform dependencies.</p></div><a class="btn-secondary" href="/services">Kelola</a></div><% if (servicesError) { %><div class="mt-4 rounded-xl border border-red-400/20 bg-red-500/10 p-3 text-xs text-red-200"><%= servicesError %></div><% } %><div class="mt-5 grid gap-3 sm:grid-cols-2"><% services.forEach(s=>{ %><div class="rounded-xl border border-white/[0.07] bg-black/15 p-4"><div class="flex items-center justify-between"><span class="font-medium"><%= s.name %></span><span class="<%= s.active===true?'badge-ok':s.active===false?'badge-bad':'badge' %>"><%= s.active===true?'active':s.active===false?'inactive':'unknown' %></span></div></div><% }) %></div></section><% } %>
  <section class="card p-5 sm:p-6"><div class="flex items-center justify-between"><div><h2 class="font-bold">Recent deployments</h2><p class="mt-1 text-sm text-slate-500">Riwayat release project terbaru.</p></div><a class="text-xs font-semibold text-gold-300" href="/deployments">View all</a></div><div class="mt-5 space-y-4"><% if(!recentDeployments.length){ %><p class="text-sm text-slate-600">Belum ada deployment.</p><% } %><% recentDeployments.forEach(d=>{ %><div class="flex gap-3"><span class="timeline-dot <%= d.status==='success'?'!bg-emerald-400':d.status==='failed'?'!bg-red-400':'!bg-amber-400' %>"></span><div class="min-w-0 flex-1"><div class="flex items-center justify-between gap-3"><span class="truncate text-sm font-semibold"><%= d.app_name %></span><span class="text-[10px] uppercase tracking-wider text-slate-600"><%= d.status %></span></div><div class="mt-1 truncate text-xs text-slate-500"><%= d.commit_sha ? d.commit_sha.slice(0,10) : d.source %> · <%= d.branch || '-' %></div></div></div><% }) %></div></section>
</div>

<section class="card mt-6 p-5 sm:p-6"><h2 class="font-bold">Audit activity</h2><p class="mt-1 text-sm text-slate-500">Perubahan administratif terbaru pada <%= dashboardScope==='platform'?'platform':'workspace aktif' %>.</p><div class="mt-5 divide-y divide-white/[0.06]"><% if(!recentLogs.length){ %><p class="py-3 text-sm text-slate-600">Belum ada aktivitas.</p><% } %><% recentLogs.forEach(log=>{ %><div class="flex flex-col justify-between gap-2 py-3 sm:flex-row sm:items-center"><div class="min-w-0"><div class="text-sm font-semibold"><%= log.action %></div><div class="truncate text-xs text-slate-500"><%= log.resource || '-' %> <%= log.detail?'· '+log.detail:'' %></div></div><span class="shrink-0 text-xs text-slate-600"><%= log.created_at %></span></div><% }) %></div></section>
<%- include('partials/app-end') %>
