<%- include('../partials/app-start') %><div class="flex justify-between gap-4"><div><div class="metric-kicker">Background runtime</div><h2 class="mt-1 text-2xl font-black"><%= app.name %> · Workers</h2><p class="mt-2 text-sm text-slate-500">Worker/queue dijalankan sebagai unit systemd terpisah dengan isolation dan resource guard.</p></div><a class="btn-secondary h-fit" href="/apps/<%= app.id %>">← Project</a></div>
<div class="mt-6 grid gap-6 xl:grid-cols-[1fr_.85fr]"><section class="table-wrap"><table class="table"><thead><tr><th>Name</th><th>Kind</th><th>Instances</th><th>Status</th><th></th></tr></thead><tbody><% if(!items.length){ %><tr><td colspan="5" class="text-slate-500">Belum ada worker.</td></tr><% } %><% items.forEach(w=>{ %><tr><td><strong><%= w.name %></strong><div class="mt-1 max-w-sm truncate font-mono text-xs text-slate-600"><%= w.command %></div></td><td><span class="badge"><%= w.kind %></span></td><td><%= w.instances %></td><td><span class="<%= w.runtime?.active?'badge-ok':'badge-warn' %>"><%= w.runtime?.active?'RUNNING':'UNKNOWN' %></span></td><td class="text-right"><form method="post" action="/workers/app/<%= app.id %>/<%= w.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-danger" data-confirm="Hapus worker?">Delete</button></form></td></tr><% }) %></tbody></table></section><section class="card p-5"><div class="metric-kicker">New process</div><h3 class="mt-1 font-bold">Create worker</h3><form class="mt-4 space-y-3" method="post" action="/workers/app/<%= app.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="field" name="name" placeholder="email-queue" required><select class="field" name="kind"><option>worker</option><option>queue</option><option>scheduler</option></select><input class="field font-mono text-xs" name="command" placeholder="node dist/worker.js" required><div class="grid grid-cols-2 gap-3"><div><label class="label">Instances</label><input class="field" name="instances" type="number" min="1" max="8" value="1"></div><div><label class="label">RAM MB</label><input class="field" name="memory_limit_mb" type="number" min="0" max="65536" value="0"></div></div><select class="field" name="restart_policy"><option value="on-failure">on-failure</option><option value="always">always</option><option value="no">no</option></select><button class="btn-primary w-full">Create worker</button></form></section></div><%- include('../partials/app-end') %>
