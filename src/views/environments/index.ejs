<%- include('../partials/app-start') %>
<div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><div class="metric-kicker">Project configuration</div><h2 class="mt-1 text-2xl font-black"><%= app.name %> · Environment</h2><p class="mt-2 text-sm text-slate-500">Nilai managed dienkripsi AES-256-GCM di SQLite. UI hanya menampilkan nama; plaintext tidak pernah dibaca ulang ke browser.</p></div><a class="btn-secondary" href="/apps/<%= app.id %>">← Project</a></div>
<div class="mt-5 flex gap-2"><% ['production','preview','development'].forEach(e=>{ %><a class="<%= environment===e?'btn-primary':'btn-secondary' %>" href="?environment=<%= e %>"><%= e %></a><% }) %></div>
<div class="mt-6 grid gap-6 xl:grid-cols-[1fr_.8fr]"><section class="table-wrap"><table class="table"><thead><tr><th>Name</th><th>Visibility</th><th>Updated</th><th></th></tr></thead><tbody><% if(!managed.length){ %><tr><td colspan="4" class="text-slate-500">Belum ada variable managed.</td></tr><% } %><% managed.forEach(v=>{ %><tr><td><code><%= v.name %></code></td><td><span class="badge"><%= v.is_secret?'secret':'config' %></span></td><td class="text-xs"><%= v.updated_at %></td><td class="text-right"><form method="post" action="/environments/app/<%= app.id %>/<%= encodeURIComponent(v.name) %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="environment" value="<%= environment %>"><button class="btn-danger" data-confirm="Hapus <%= v.name %>?">Delete</button></form></td></tr><% }) %></tbody></table></section><section class="card p-5"><div class="metric-kicker">Add / rotate</div><h3 class="mt-1 font-bold">Environment variable</h3><form class="mt-4 space-y-4" method="post" action="/environments/app/<%= app.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="environment" value="<%= environment %>"><div><label class="label">Name</label><input class="field font-mono" name="name" placeholder="DATABASE_URL" required></div><div><label class="label">Value</label><textarea class="field min-h-24 font-mono text-xs" name="value" required></textarea></div><label class="flex items-center gap-2 text-xs text-slate-400"><input type="checkbox" name="is_secret" value="1" checked> Secret / masked</label><button class="btn-primary w-full">Save variable</button></form><% if(unmanaged.length){ %><div class="mt-6 border-t border-white/[.08] pt-4"><div class="text-xs font-semibold">Legacy file keys</div><p class="mt-1 text-xs text-slate-600">Masih ada di env file server dan tidak dibaca plaintext ke UI.</p><div class="mt-2 flex flex-wrap gap-2"><% unmanaged.forEach(k=>{ %><span class="badge"><%= k %></span><% }) %></div></div><% } %></section></div>
<%- include('../partials/app-end') %>
