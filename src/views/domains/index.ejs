<%- include('../partials/app-start') %>
<% if (platform === 'nat' || platform === 'proxy') { %>
<section class="mb-6 rounded-2xl border border-gold-400/20 bg-gold-400/[0.06] p-5 sm:p-6">
  <h2 class="font-bold text-gold-400"><%= platform === 'nat' ? 'Routing NAT / Public Endpoint' : 'Routing Reverse Proxy / Edge' %></h2>
  <% if (platform === 'nat' && tlsMode === 'local') { %>
    <p class="mt-2 text-sm text-slate-300">Untuk setiap hostname, arahkan <strong>HTTP publik 80 → Nginx 80</strong> dan <strong>HTTPS publik 443 → Nginx 443</strong>. TLS/Let’s Encrypt berada di VPS.</p>
  <% } else if (platform === 'proxy' || tlsMode === 'edge') { %>
    <p class="mt-2 text-sm text-slate-300">TLS diterminasi oleh edge/reverse proxy provider. Pastikan hostname diteruskan ke Nginx dan header <strong>X-Forwarded-Proto</strong> dipertahankan.</p>
  <% } else { %>
    <p class="mt-2 text-sm text-slate-300">Pastikan port publik provider diteruskan ke Nginx sesuai TLS mode yang dipilih.</p>
  <% } %>
  <p class="mt-2 text-xs text-slate-500">Node app tetap hanya di localhost. Jangan expose port aplikasi langsung ke Internet.</p>
  <% if (tlsMode === 'local') { %>
    <p class="mt-2 text-xs text-slate-400">Urutan: DNS + HTTP publik → <strong>Tes ACME</strong> → opsional <strong>Tes Staging</strong> → <strong>Pasang SSL</strong> → HTTPS publik. Jika CA memberi rate-limit, panel menahan retry production sampai cooldown selesai.</p>
  <% } %>
</section>
<% } %>

<section class="card p-5 sm:p-6">
  <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
    <div><h2 class="font-bold">Tambah reverse proxy</h2><p class="mt-1 text-sm text-slate-500">Domain → Nginx → port Node.js di localhost.</p></div>
  </div>
  <form method="post" action="/domains" class="mt-5 grid gap-4 lg:grid-cols-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label class="label">Hostname</label><input class="field" name="hostname" placeholder="api.example.com" required></div>
    <div><label class="label">Aplikasi</label><select class="field" name="app_id"><option value="">Port manual</option><% apps.forEach(a => { %><option value="<%= a.id %>"><%= a.name %> (:<%= a.port %>)</option><% }) %></select></div>
    <div><label class="label">Port manual</label><input class="field" type="number" name="target_port" min="1024" max="65535" placeholder="4100"></div>
    <div class="self-end"><button class="btn-primary w-full" type="submit">Aktifkan Nginx</button></div>
  </form>
</section>

<section class="mt-6 space-y-4">
  <% if (!domains.length) { %><div class="card p-7 text-sm text-slate-500">Belum ada domain.</div><% } %>
  <% domains.forEach(d => { const cooldown = d.ssl_retry_after && new Date(d.ssl_retry_after).getTime() > Date.now(); %>
    <article class="card p-5">
      <div class="flex flex-col justify-between gap-4 xl:flex-row xl:items-start">
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="font-bold"><%= d.hostname %></h3>
            <span class="badge">127.0.0.1:<%= d.target_port %></span>
            <span class="badge"><%= d.nginx_enabled ? 'NGINX AKTIF' : 'NGINX OFF' %></span>
            <% if (tlsMode === 'edge') { %><span class="badge">EDGE TLS</span><% } else if (d.ssl_enabled) { %><span class="badge">HTTPS</span><% } else { %><span class="badge">HTTP</span><% } %>
          </div>
          <div class="mt-2 text-sm text-slate-500"><%= d.app_name || 'manual upstream' %></div>
          <% if (d.ssl_last_preflight_at) { %><div class="mt-2 text-xs text-slate-500">ACME preflight: <%= d.ssl_last_preflight_ok ? 'OK' : 'GAGAL' %> · <%= d.ssl_last_preflight_at %></div><% } %>
          <% if (cooldown) { %><div class="mt-3 rounded-xl border border-amber-400/20 bg-amber-400/[0.06] p-3 text-sm text-amber-200">Rate-limit production aktif. Request baru ditahan sampai <strong><%= d.ssl_retry_after %></strong>. Gunakan Tes Staging bila ingin mengecek konfigurasi tanpa menghabiskan kuota production.</div><% } %>
          <% if (d.ssl_last_error) { %><details class="mt-3"><summary class="cursor-pointer text-xs text-slate-400">Detail error SSL terakhir</summary><pre class="mt-2 whitespace-pre-wrap rounded-xl border border-white/10 bg-black/20 p-3 text-xs text-slate-400"><%= d.ssl_last_error %></pre></details><% } %>
          <details class="mt-4 rounded-xl border border-white/[0.07] bg-black/15 p-4"><summary class="cursor-pointer text-xs font-semibold text-slate-400">Advanced Nginx settings</summary><form class="mt-4 grid gap-3 sm:grid-cols-2" method="post" action="/domains/<%= d.id %>/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="flex items-center gap-2 text-sm"><input type="checkbox" name="redirect_https" value="1" <%= d.redirect_https?'checked':'' %>> Redirect HTTP → HTTPS</label><label class="flex items-center gap-2 text-sm"><input type="checkbox" name="websocket_enabled" value="1" <%= d.websocket_enabled?'checked':'' %>> WebSocket headers</label><label class="flex items-center gap-2 text-sm"><input type="checkbox" name="maintenance_mode" value="1" <%= d.maintenance_mode?'checked':'' %>> Maintenance mode (503)</label><div><label class="label">Canonical</label><select class="field" name="canonical_mode"><option value="none" <%= d.canonical_mode==='none'?'selected':'' %>>none</option><option value="www" <%= d.canonical_mode==='www'?'selected':'' %>>www</option><option value="non-www" <%= d.canonical_mode==='non-www'?'selected':'' %>>non-www</option></select></div><div><label class="label">Upload limit MB</label><input class="field" type="number" min="1" max="2048" name="upload_limit_mb" value="<%= d.upload_limit_mb||25 %>"></div><div><label class="label">Proxy timeout sec</label><input class="field" type="number" min="5" max="3600" name="proxy_timeout_sec" value="<%= d.proxy_timeout_sec||60 %>"></div><div class="sm:col-span-2"><label class="label">Custom security headers (JSON)</label><textarea class="field min-h-28 font-mono text-xs" name="custom_headers_json"><%= d.custom_headers_json||'{}' %></textarea><p class="mt-1 text-xs text-slate-600">Allowlist: X-Frame-Options, X-Content-Type-Options, Referrer-Policy, Permissions-Policy, Content-Security-Policy, Cache-Control, COOP/CORP.</p></div><div class="sm:col-span-2"><button class="btn-secondary" type="submit">Apply Nginx settings</button></div></form></details>
        </div>
        <div class="flex flex-wrap gap-2 xl:justify-end">
          <% if (tlsMode === 'local' && !d.ssl_enabled) { %>
            <form method="post" action="/domains/<%= d.id %>/ssl-test"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-secondary" type="submit">Tes ACME</button></form>
            <form method="post" action="/domains/<%= d.id %>/ssl-staging"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-secondary" type="submit">Tes Staging</button></form>
            <form method="post" action="/domains/<%= d.id %>/ssl-sync"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-secondary" title="Gunakan setelah menerbitkan certificate via SSH" type="submit">Sinkronkan SSL Manual</button></form>
            <form method="post" action="/domains/<%= d.id %>/ssl"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-primary" <%= cooldown ? 'disabled' : '' %> data-confirm="Pastikan DNS dan HTTP 80 → Internal 80 sudah aktif. Request production Let’s Encrypt dapat terkena rate-limit. Lanjut?" type="submit"><%= cooldown ? 'Menunggu Cooldown' : 'Pasang SSL' %></button></form>
          <% } %>
          <form method="post" action="/domains/<%= d.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-danger" data-confirm="Hapus virtual host Nginx ini?" type="submit">Hapus</button></form>
        </div>
      </div>
    </article>
  <% }) %>
</section>
<%- include('../partials/app-end') %>
