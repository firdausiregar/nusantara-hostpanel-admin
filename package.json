{
  "name": "nusantara-hostpanel-admin",
  "version": "1.0.0",
  "private": false,
  "description": "Production-grade security-first self-hosted Node.js SaaS/PaaS with hierarchical MVC, Midtrans billing, GitHub OAuth/App imports, i18n, notifications, preview deployments, atomic releases, Nginx/BIND9/MariaDB/Let's Encrypt automation, and laptop-safe development.",
  "main": "src/app.js",
  "type": "commonjs",
  "scripts": {
    "dev:setup": "node scripts/dev/setup.js",
    "dev": "node scripts/dev/run.js",
    "start": "node src/app.js",
    "css:build": "npx @tailwindcss/cli -i ./public/css/input.css -o ./public/css/app.css --minify",
    "check": "node scripts/check-architecture.js",
    "test": "npm run check && npm run check:assets && npm run check:migrations && npm run test:security && npm run test:rbac && npm run test:integrations",
    "test:security": "node test/security-basics.js",
    "release:check": "bash scripts/release-check.sh",
    "check:assets": "node scripts/check-assets.js",
    "check:migrations": "node scripts/check-migrations.js",
    "smoke:local": "node scripts/smoke-local.js",
    "docs:build": "bash scripts/docs-build.sh",
    "quality": "npm run check && npm run test:security && npm run test:rbac && npm run test:integrations && npm run check:assets && npm run check:migrations",
    "test:rbac": "node test/rbac-basics.js",
    "test:integrations": "node test/integrations-basics.js"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/firdausiregar/nusantara-hostpanel-admin.git"
  },
  "bugs": {
    "url": "https://github.com/firdausiregar/nusantara-hostpanel-admin/issues"
  },
  "homepage": "https://github.com/firdausiregar/nusantara-hostpanel-admin#readme",
  "dependencies": {
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.3",
    "ejs": "6.0.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "nodemailer": "10.0.10",
    "multer": "2.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "nodemon": "3.1.14",
    "tailwindcss": "4.3.3"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "@parcel/watcher": true
  },
  "license": "MIT"
}
